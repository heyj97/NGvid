<!-- 속성 패널과 영상 클립 스튜디오가 함께 쓰는 모양: 숫자 칸, 이름표, 구역 제목, 구분선, 키프레임 버튼. -->
<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
        <Setter Property="Padding" Value="8,4" />
        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
        <Setter Property="FontSize" Value="12" />
        <Setter Property="Width" Value="76" />
        <Setter Property="HorizontalAlignment" Value="Right" />
    </Style>
    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
        <Setter Property="MinWidth" Value="110" />
    </Style>
    <Style x:Key="Label" TargetType="TextBlock">
        <Setter Property="Foreground" Value="{StaticResource Muted}" />
        <Setter Property="VerticalAlignment" Value="Center" />
    </Style>
    <Style x:Key="Title" TargetType="TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="Bold" />
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <Style x:Key="Divider" TargetType="Border">
        <Setter Property="Height" Value="1" />
        <Setter Property="Background" Value="{StaticResource Line}" />
        <Setter Property="Margin" Value="-16,4,-16,12" />
    </Style>
    <Style TargetType="DockPanel">
        <Setter Property="Margin" Value="0,0,0,10" />
    </Style>
    <!-- 키프레임 버튼: ◆ 여기 있음, ◈ 다른 곳에 있음, ◇ 없음 -->
    <Style x:Key="Key" TargetType="Button" BasedOn="{StaticResource Ghost}">
        <Setter Property="Focusable" Value="False" />
        <Setter Property="Width" Value="28" />
        <Setter Property="Height" Value="28" />
        <Setter Property="Margin" Value="4,0,-6,0" />
        <Setter Property="Foreground" Value="{StaticResource Accent}" />
        <Style.Triggers>
            <Trigger Property="Content" Value="◇">
                <Setter Property="Foreground" Value="#5C6370" />
            </Trigger>
        </Style.Triggers>
    </Style>
</ResourceDictionary>
