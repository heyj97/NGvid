<Window x:Class="NGL.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="NGvid" Width="1280" Height="800" MinWidth="900" MinHeight="400"
        Background="#101114" Foreground="#E6E7EA" FontSize="14"
        AllowDrop="True" Drop="OnDrop">
    <Window.InputBindings>
        <KeyBinding Key="Space" Command="{Binding PlayPauseCommand}" />
        <KeyBinding Key="Left" Command="{Binding StepCommand}" CommandParameter="-1" />
        <KeyBinding Key="Right" Command="{Binding StepCommand}" CommandParameter="1" />
        <KeyBinding Key="I" Command="{Binding SetLoopStartCommand}" />
        <KeyBinding Key="O" Command="{Binding SetLoopEndCommand}" />
        <KeyBinding Key="L" Command="{Binding ToggleLoopCommand}" />
    </Window.InputBindings>
    <Window.Resources>
        <!-- 키보드 단축키가 창으로 가도록 버튼과 슬라이더는 포커스를 받지 않는다. -->
        <Style TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="#26292F" />
            <Setter Property="Foreground" Value="#E6E7EA" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
    </Window.Resources>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#17181C" BorderBrush="#2A2D33" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="영상 열기" Click="OnOpenClick"
                        Padding="16,6" Background="#4C8DFF" Foreground="#0B0C0E" FontWeight="Bold" />
                <TextBlock x:Name="AudioWarningLabel" DockPanel.Dock="Right" Text="{Binding AudioWarning}"
                           Margin="10,0,0,0" VerticalAlignment="Center" Foreground="#FFB454" />
                <TextBlock Text="{Binding InfoText}" Margin="10,0,0,0" VerticalAlignment="Center"
                           Foreground="#A7ACB4" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <skia:SKGLElement Grid.Row="1" x:Name="Preview" PaintSurface="OnPaintSurface" />

        <Border Grid.Row="2" Background="#17181C" BorderBrush="#2A2D33" BorderThickness="0,1,0,0" Padding="16,12">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,10,0">
                    <Button Content="◀ 1프레임" Command="{Binding StepCommand}" CommandParameter="-1" ToolTip="← 키" />
                    <Button x:Name="PlayButton" Content="{Binding PlayButtonText}" Command="{Binding PlayPauseCommand}"
                            MinWidth="84" Background="#4C8DFF" Foreground="#0B0C0E" FontWeight="Bold" ToolTip="스페이스 키" />
                    <Button Content="1프레임 ▶" Command="{Binding StepCommand}" CommandParameter="1" ToolTip="→ 키" />
                </StackPanel>

                <TextBlock x:Name="TimeLabel" DockPanel.Dock="Right" Text="{Binding TimeText}" Margin="10,0,0,0"
                           VerticalAlignment="Center" FontFamily="Consolas" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
                    <Button Content="시작점" Command="{Binding SetLoopStartCommand}" ToolTip="현재 위치를 반복 구간의 시작으로 (I 키)" />
                    <Button Content="끝점" Command="{Binding SetLoopEndCommand}" ToolTip="현재 위치를 반복 구간의 끝으로 (O 키)" />
                    <CheckBox x:Name="LoopCheck" Content="구간 반복" IsChecked="{Binding IsLooping}" Focusable="False"
                              Foreground="#E6E7EA" VerticalAlignment="Center" Margin="4,0,8,0" ToolTip="L 키" />
                    <TextBlock Text="{Binding LoopText}" VerticalAlignment="Center" Foreground="#A7ACB4" FontFamily="Consolas" />
                </StackPanel>

                <Slider x:Name="PositionSlider" Minimum="0" Maximum="{Binding LastFrameSeconds}"
                        Value="{Binding PositionSeconds}" Focusable="False"
                        IsMoveToPointEnabled="True" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
