<Window x:Class="NGL.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        xmlns:local="clr-namespace:NGL.App"
        Title="{Binding Title}" Width="1360" Height="840" MinWidth="1000" MinHeight="500"
        Background="#101114" Foreground="#E6E7EA" FontSize="13"
        AllowDrop="True" Drop="OnDrop" PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <!-- 키보드 단축키가 창으로 가도록 버튼은 포커스를 받지 않는다. -->
        <Style TargetType="Button">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Padding" Value="12,6" />
            <Setter Property="Margin" Value="0,0,6,0" />
            <Setter Property="Background" Value="#26292F" />
            <Setter Property="Foreground" Value="#E6E7EA" />
            <Setter Property="BorderThickness" Value="0" />
        </Style>
        <Style x:Key="Primary" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Background" Value="#4C8DFF" />
            <Setter Property="Foreground" Value="#0B0C0E" />
            <Setter Property="FontWeight" Value="Bold" />
        </Style>

        <!-- 켜고 끄는 작은 버튼: 켜지면 강조색 -->
        <Style x:Key="Toggle" TargetType="ToggleButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="#8E949C" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">
                        <Border x:Name="Back" Background="Transparent" CornerRadius="5" Padding="6,4" Margin="0,0,2,0">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#26292F" />
                                <Setter Property="Foreground" Value="#4C8DFF" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!-- 보관함의 영상·사운드·이미지 탭 -->
        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="#A7ACB4" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Back" Background="Transparent" CornerRadius="6" Padding="10,6" Margin="0,0,4,0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="#26292F" />
                                <Setter Property="Foreground" Value="#E6E7EA" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 상단: 메뉴, 프로젝트 이름, 시퀀스 규격 -->
        <Border Grid.Row="0" Background="#17181C" BorderBrush="#2A2D33" BorderThickness="0,0,0,1" Padding="12,6">
            <DockPanel>
                <TextBlock DockPanel.Dock="Left" Text="NGvid" FontSize="15" FontWeight="Bold" VerticalAlignment="Center" Margin="0,0,12,0" />
                <Menu DockPanel.Dock="Left" Background="Transparent" Foreground="#C9CCD1" VerticalAlignment="Center" Focusable="False">
                    <MenuItem Header="파일" Padding="10,6">
                        <MenuItem Header="새 프로젝트" InputGestureText="Ctrl+N" Click="OnNewClick" Foreground="Black" />
                        <MenuItem Header="열기" InputGestureText="Ctrl+O" Click="OnOpenClick" Foreground="Black" />
                        <MenuItem Header="저장" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}" Foreground="Black" />
                        <Separator />
                        <MenuItem Header="미디어 가져오기" InputGestureText="Ctrl+I" Click="OnImportClick" Foreground="Black"
                                  IsEnabled="{Binding HasProject}" />
                        <MenuItem x:Name="ExportItem" Header="내보내기" InputGestureText="Ctrl+E" Click="OnExportClick" Foreground="Black"
                                  IsEnabled="{Binding HasProject}" />
                    </MenuItem>
                    <MenuItem x:Name="ViewMenu" Header="보기" Padding="10,6" IsEnabled="{Binding HasProject}">
                        <MenuItem x:Name="SafeAreaItem" Header="안전 영역 표시" IsCheckable="True" IsChecked="{Binding ShowSafeArea}" Foreground="Black" />
                    </MenuItem>
                    <MenuItem x:Name="TextMenu" Header="텍스트·자막" Padding="10,6" IsEnabled="{Binding HasProject}">
                        <MenuItem x:Name="AddTextItem" Header="텍스트 추가" InputGestureText="T" Command="{Binding AddTextCommand}" Foreground="Black" />
                        <MenuItem x:Name="AddCaptionItem" Header="자막 추가" InputGestureText="C" Command="{Binding AddCaptionCommand}" Foreground="Black" />
                        <Separator />
                        <MenuItem x:Name="CaptionListItem" Header="자막 목록…" Click="OnCaptionListClick" Foreground="Black" />
                    </MenuItem>
                    <MenuItem x:Name="EditMenu" Header="편집" Padding="10,6" IsEnabled="{Binding HasProject}">
                        <MenuItem x:Name="UndoItem" Header="{Binding UndoText}" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" Foreground="Black" />
                        <MenuItem x:Name="RedoItem" Header="{Binding RedoText}" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" Foreground="Black" />
                        <Separator />
                        <MenuItem x:Name="SplitItem" Header="재생 위치에서 분할" InputGestureText="Ctrl+K" Command="{Binding SplitCommand}" Foreground="Black" />
                        <MenuItem x:Name="DeleteItem" Header="삭제" InputGestureText="Delete" Command="{Binding DeleteCommand}" Foreground="Black" />
                        <MenuItem x:Name="RippleDeleteItem" Header="리플 삭제" InputGestureText="Shift+Delete" Command="{Binding RippleDeleteCommand}" Foreground="Black" />
                        <Separator />
                        <MenuItem x:Name="CopyItem" Header="복사" InputGestureText="Ctrl+C" Command="{Binding CopyCommand}" Foreground="Black" />
                        <MenuItem x:Name="PasteItem" Header="붙여넣기" InputGestureText="Ctrl+V" Command="{Binding PasteCommand}" Foreground="Black" />
                        <MenuItem x:Name="PastePropertiesItem" Header="속성 붙여넣기" InputGestureText="Ctrl+Alt+V" Command="{Binding PastePropertiesCommand}" Foreground="Black"
                                  ToolTip="복사한 클립의 변형·볼륨·페이드 등을 선택한 클립에 입힙니다" />
                        <MenuItem x:Name="SelectAllItem" Header="모두 선택" InputGestureText="Ctrl+A" Command="{Binding SelectAllCommand}" Foreground="Black" />
                        <Separator />
                        <MenuItem x:Name="GroupItem" Header="그룹" InputGestureText="Ctrl+G" Command="{Binding GroupCommand}" Foreground="Black" />
                        <MenuItem x:Name="UngroupItem" Header="그룹 해제" InputGestureText="Ctrl+Shift+G" Command="{Binding UngroupCommand}" Foreground="Black" />
                        <MenuItem x:Name="LinkItem" Header="영상·오디오 연결" Command="{Binding LinkCommand}" Foreground="Black" />
                        <MenuItem x:Name="UnlinkItem" Header="영상·오디오 분리" Command="{Binding UnlinkCommand}" Foreground="Black" />
                    </MenuItem>
                </Menu>

                <Button x:Name="ExportButton" DockPanel.Dock="Right" Content="내보내기" Click="OnExportClick" Style="{StaticResource Primary}"
                        Margin="10,0,0,0" IsEnabled="{Binding HasProject}" ToolTip="MP4로 내보내기 (Ctrl+E)" />
                <ComboBox x:Name="QualityBox" DockPanel.Dock="Right" SelectedIndex="{Binding QualityIndex}" Focusable="False"
                          Width="100" VerticalAlignment="Center" ToolTip="미리보기 화질">
                    <ComboBoxItem Content="화질 전체" />
                    <ComboBoxItem Content="화질 1/2" />
                    <ComboBoxItem Content="화질 1/4" />
                </ComboBox>
                <TextBlock x:Name="AudioWarningLabel" DockPanel.Dock="Right" Text="{Binding AudioWarning}"
                           Margin="10,0" VerticalAlignment="Center" Foreground="#FFB454" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="ProjectNameLabel" Text="{Binding Project.Name}" FontWeight="Medium" VerticalAlignment="Center" />
                    <Border BorderBrush="#33363D" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="8,0,0,0"
                            Visibility="{Binding HasProject, Converter={StaticResource Visible}}">
                        <TextBlock x:Name="SequenceLabel" Text="{Binding SequenceText}" FontSize="12" Foreground="#A7ACB4" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 가운데: 보관함 + 미리보기 -->
        <Grid Grid.Row="1" Visibility="{Binding HasProject, Converter={StaticResource Visible}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="300" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="260" />
            </Grid.ColumnDefinitions>

            <Border Grid.Column="0" Background="#17181C" BorderBrush="#2A2D33" BorderThickness="0,0,1,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="12,12,12,8">
                        <Button x:Name="ImportButton" DockPanel.Dock="Right" Content="＋ 가져오기" Click="OnImportClick" Margin="0"
                                ToolTip="미디어 가져오기 (Ctrl+I). 파일을 창에 끌어 놓아도 됩니다." />
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="VideoTab" Content="영상" Style="{StaticResource Tab}" Tag="0" Checked="OnTabChecked" IsChecked="True" />
                            <RadioButton x:Name="SoundTab" Content="사운드" Style="{StaticResource Tab}" Checked="OnTabChecked" Tag="1" />
                            <RadioButton x:Name="ImageTab" Content="이미지" Style="{StaticResource Tab}" Checked="OnTabChecked" Tag="2" />
                        </StackPanel>
                    </DockPanel>

                    <!-- 사라진 원본 안내 -->
                    <Border x:Name="MissingBanner" DockPanel.Dock="Top" Background="#3A2A1A" Margin="12,0,12,8" Padding="10,8" CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MissingCount}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="폴더에서 찾기" Click="OnRelinkFolderClick" Margin="8,0,0,0" />
                            <TextBlock VerticalAlignment="Center" Foreground="#FFB454" TextWrapping="Wrap">
                                <Run Text="원본 파일" /><Run x:Name="MissingCountRun" Text="{Binding MissingCount, Mode=OneWay}" /><Run Text="개가 없습니다." />
                            </TextBlock>
                        </DockPanel>
                    </Border>

                    <ListBox x:Name="AssetList" ItemsSource="{Binding VisibleAssets}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="6,0" Focusable="False">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" VerticalAlignment="Top" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem">
                                <Setter Property="Padding" Value="5" />
                                <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                                <Setter Property="Focusable" Value="False" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="타임라인에 추가" Click="OnAddToTimelineClick" />
                                            <MenuItem Header="다시 연결…" Click="OnRelinkClick" />
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <Border Height="74" CornerRadius="6" Background="#1F2126" BorderBrush="#2A2D33" BorderThickness="1" ClipToBounds="True"
                                            MouseMove="OnAssetMouseMove" ToolTip="타임라인으로 끌어 놓을 수 있습니다">
                                        <Grid>
                                            <Image Source="{Binding Thumbnail}" Stretch="Uniform" />
                                            <TextBlock Text="원본 없음" Foreground="#FF7A7A" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding IsMissing, Converter={StaticResource Visible}}" />
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4" Padding="5,1"
                                                    CornerRadius="4" Background="#B0000000">
                                                <TextBlock Text="{Binding DurationText}" FontFamily="Consolas" FontSize="11" />
                                            </Border>
                                            <Button Content="＋" ToolTip="타임라인 맨 뒤에 추가" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="4" Padding="6,1" Style="{StaticResource Primary}"
                                                    Command="{Binding DataContext.AddToTimelineCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                    <!-- 이름을 고치면 이 원본을 쓰는 모든 클립에 반영된다. Enter 또는 다른 곳 클릭으로 확정. -->
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown"
                                             Background="Transparent" Foreground="#C9CCD1" BorderThickness="0" CaretBrush="#E6E7EA"
                                             FontSize="12" Margin="0,4,0,0" ToolTip="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 미리보기: 선택한 클립을 끌어 옮기고 마우스 휠로 크기를 바꾼다. -->
            <skia:SKGLElement Grid.Column="1" x:Name="Preview" PaintSurface="OnPaintSurface"
                              MouseLeftButtonDown="OnPreviewMouseDown" MouseMove="OnPreviewMouseMove"
                              MouseLeftButtonUp="OnPreviewMouseUp" MouseWheel="OnPreviewWheel" />

            <!-- 속성 패널: 선택한 오디오 클립과 그 트랙. 값은 Enter나 다른 곳 클릭으로 확정한다. -->
            <Border Grid.Column="2" Background="#17181C" BorderBrush="#2A2D33" BorderThickness="1,0,0,0" Padding="14,12">
                <Border.Resources>
                    <Style TargetType="TextBox">
                        <Setter Property="Background" Value="#1F2126" />
                        <Setter Property="Foreground" Value="#E6E7EA" />
                        <Setter Property="BorderBrush" Value="#33363D" />
                        <Setter Property="CaretBrush" Value="#E6E7EA" />
                        <Setter Property="Padding" Value="6,4" />
                        <Setter Property="Width" Value="70" />
                        <Setter Property="HorizontalAlignment" Value="Right" />
                    </Style>
                    <Style x:Key="Label" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="#A7ACB4" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Margin" Value="0,0,0,8" />
                    </Style>
                </Border.Resources>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel>
                    <TextBlock Text="클립을 선택하면 여기에서 속성을 바꿀 수 있습니다." Foreground="#8E949C" TextWrapping="Wrap"
                               Visibility="{Binding HasNoSelection, Converter={StaticResource Visible}}" />

                    <!-- 영상·이미지 클립 -->
                    <StackPanel x:Name="VisualInspector" Margin="0,0,0,16" Visibility="{Binding HasVisualSelection, Converter={StaticResource Visible}}">
                        <TextBlock x:Name="VisualTitle" Text="{Binding VisualTitle}" FontWeight="Medium" Margin="0,0,0,12" />
                        <DockPanel>
                            <Button x:Name="PositionKeyButton" DockPanel.Dock="Right" Content="{Binding PositionKey}" Command="{Binding ToggleKeyframeCommand}" CommandParameter="Position"
                                    Padding="5,2" Margin="4,0,0,0" ToolTip="재생 위치에 키프레임 찍기·지우기 (◆ 여기 있음, ◈ 다른 곳에 있음, ◇ 없음)" />
                            <TextBox x:Name="PositionYBox" DockPanel.Dock="Right" Width="56" Margin="6,0,0,0" Text="{Binding PositionY, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" ToolTip="아래로 (픽셀)" />
                            <TextBox x:Name="PositionXBox" DockPanel.Dock="Right" Width="56" Text="{Binding PositionX, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" ToolTip="오른쪽으로 (픽셀)" />
                            <TextBlock Text="위치 X · Y" Style="{StaticResource Label}" ToolTip="화면 가운데에서 옮긴 거리. 미리보기에서 끌어도 됩니다." />
                        </DockPanel>
                        <DockPanel>
                            <Button x:Name="ScaleKeyButton" DockPanel.Dock="Right" Content="{Binding ScaleKey}" Command="{Binding ToggleKeyframeCommand}" CommandParameter="Scale"
                                    Padding="5,2" Margin="4,0,0,0" ToolTip="재생 위치에 키프레임 찍기·지우기 (◆ 여기 있음, ◈ 다른 곳에 있음, ◇ 없음)" />
                            <TextBox x:Name="ScaleBox" DockPanel.Dock="Right" Text="{Binding ScalePercent, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="크기 (%)" Style="{StaticResource Label}" ToolTip="10~400. 미리보기에서 마우스 휠로도 바꿀 수 있습니다." />
                        </DockPanel>
                        <DockPanel>
                            <Button x:Name="RotationKeyButton" DockPanel.Dock="Right" Content="{Binding RotationKey}" Command="{Binding ToggleKeyframeCommand}" CommandParameter="Rotation"
                                    Padding="5,2" Margin="4,0,0,0" ToolTip="재생 위치에 키프레임 찍기·지우기 (◆ 여기 있음, ◈ 다른 곳에 있음, ◇ 없음)" />
                            <TextBox x:Name="RotationBox" DockPanel.Dock="Right" Text="{Binding RotationDegrees, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="회전 (도)" Style="{StaticResource Label}" />
                        </DockPanel>
                        <DockPanel>
                            <Button x:Name="OpacityKeyButton" DockPanel.Dock="Right" Content="{Binding OpacityKey}" Command="{Binding ToggleKeyframeCommand}" CommandParameter="Opacity"
                                    Padding="5,2" Margin="4,0,0,0" ToolTip="재생 위치에 키프레임 찍기·지우기 (◆ 여기 있음, ◈ 다른 곳에 있음, ◇ 없음)" />
                            <TextBox x:Name="OpacityBox" DockPanel.Dock="Right" Text="{Binding OpacityPercent, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="불투명도 (%)" Style="{StaticResource Label}" />
                        </DockPanel>
                        <DockPanel>
                            <ComboBox x:Name="BlendBox" DockPanel.Dock="Right" Width="110" ItemsSource="{x:Static local:MainViewModel.BlendNames}"
                                      SelectedIndex="{Binding BlendIndex}" Focusable="False" />
                            <TextBlock Text="블렌드 모드" Style="{StaticResource Label}" />
                        </DockPanel>
                        <DockPanel>
                            <ComboBox x:Name="FitBox" DockPanel.Dock="Right" Width="150" ItemsSource="{x:Static local:MainViewModel.FitNames}"
                                      SelectedIndex="{Binding FitIndex}" Focusable="False" />
                            <TextBlock Text="화면 맞춤" Style="{StaticResource Label}" />
                        </DockPanel>
                        <TextBlock Text="자르기 (%)  왼쪽 · 위 · 오른쪽 · 아래" Style="{StaticResource Label}" Margin="0,4,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox x:Name="CropLeftBox" Width="52" Margin="0,0,6,0" Text="{Binding CropLeft, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBox x:Name="CropTopBox" Width="52" Margin="0,0,6,0" Text="{Binding CropTop, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBox x:Name="CropRightBox" Width="52" Margin="0,0,6,0" Text="{Binding CropRight, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBox x:Name="CropBottomBox" Width="52" Text="{Binding CropBottom, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox x:Name="FlipHorizontalBox" Content="좌우 뒤집기" IsChecked="{Binding FlipHorizontal}" Foreground="#E6E7EA" Focusable="False" Margin="0,0,14,0" />
                            <CheckBox x:Name="FlipVerticalBox" Content="상하 뒤집기" IsChecked="{Binding FlipVertical}" Foreground="#E6E7EA" Focusable="False" />
                        </StackPanel>
                        <Button x:Name="ResetTransformButton" Content="변형 초기화" Command="{Binding ResetTransformCommand}" Margin="0"
                                ToolTip="위치·크기·회전·자르기·뒤집기를 처음 상태로 되돌립니다" />

                        <!-- 전환, 효과, 색보정 -->
                        <TextBlock Text="전환" FontWeight="Medium" Margin="0,16,0,12" />
                        <DockPanel>
                            <TextBox x:Name="TransitionSecondsBox" DockPanel.Dock="Right" Width="44" Margin="6,0,0,0" Text="{Binding TransitionSeconds, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" ToolTip="길이 (초)" />
                            <ComboBox x:Name="TransitionBox" DockPanel.Dock="Right" Width="130" ItemsSource="{x:Static local:MainViewModel.TransitionNames}"
                                      SelectedIndex="{Binding TransitionIndex}" Focusable="False" />
                            <TextBlock Text="시작" Style="{StaticResource Label}"
                                       ToolTip="앞 클립에서 이 클립으로 넘어올 때의 효과. 같은 트랙에서 바로 앞에 붙은 클립과 이어집니다." />
                        </DockPanel>

                        <TextBlock Text="효과" FontWeight="Medium" Margin="0,8,0,12" />
                        <DockPanel>
                            <TextBox x:Name="BlurBox" DockPanel.Dock="Right" Text="{Binding BlurAmount, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="흐림 (0~100)" Style="{StaticResource Label}" />
                        </DockPanel>
                        <DockPanel>
                            <TextBox x:Name="SharpenBox" DockPanel.Dock="Right" Text="{Binding SharpenPercent, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="선명하게 (%)" Style="{StaticResource Label}" />
                        </DockPanel>
                        <DockPanel>
                            <TextBox x:Name="VignetteBox" DockPanel.Dock="Right" Text="{Binding VignettePercent, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="비네팅 (%)" Style="{StaticResource Label}" ToolTip="가장자리를 어둡게 합니다" />
                        </DockPanel>

                        <TextBlock Text="색보정" FontWeight="Medium" Margin="0,8,0,12" ToolTip="-100~100, 0이 원래 그대로" />
                        <DockPanel>
                            <TextBox x:Name="ExposureBox" DockPanel.Dock="Right" Text="{Binding ExposureStops, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="노출 (-2~2)" Style="{StaticResource Label}" ToolTip="1마다 밝기가 두 배" />
                        </DockPanel>
                        <DockPanel>
                            <TextBox x:Name="BrightnessBox" DockPanel.Dock="Right" Text="{Binding BrightnessPercent, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="밝기 (%)" Style="{StaticResource Label}" />
                        </DockPanel>
                        <DockPanel>
                            <TextBox x:Name="ContrastBox" DockPanel.Dock="Right" Text="{Binding ContrastPercent, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="대비 (%)" Style="{StaticResource Label}" />
                        </DockPanel>
                        <DockPanel>
                            <TextBox x:Name="SaturationBox" DockPanel.Dock="Right" Text="{Binding SaturationPercent, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="채도 (%)" Style="{StaticResource Label}" ToolTip="-100이면 흑백" />
                        </DockPanel>
                        <DockPanel>
                            <TextBox x:Name="TemperatureBox" DockPanel.Dock="Right" Text="{Binding TemperaturePercent, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="색온도 (%)" Style="{StaticResource Label}" ToolTip="양수는 따뜻하게, 음수는 차갑게" />
                        </DockPanel>
                        <DockPanel>
                            <Button x:Name="ClearLutButton" DockPanel.Dock="Right" Content="해제" Command="{Binding ClearLutCommand}" Margin="4,0,0,0" Padding="8,4" IsEnabled="{Binding HasLut}" />
                            <Button x:Name="ImportLutButton" DockPanel.Dock="Right" Content="불러오기" Click="OnImportLutClick" Margin="4,0,0,0" Padding="8,4" ToolTip=".cube 파일을 골라 색감을 적용합니다" />
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <Run Text="LUT  " Foreground="#A7ACB4" /><Run x:Name="LutNameRun" Text="{Binding LutName, Mode=OneWay}" />
                            </TextBlock>
                        </DockPanel>
                        <Button x:Name="ResetEffectsButton" Content="효과·색보정 초기화" Command="{Binding ResetEffectsCommand}" Margin="0" />
                    </StackPanel>

                    <!-- 텍스트·자막 -->
                    <StackPanel x:Name="TextInspector" Margin="0,0,0,16" Visibility="{Binding HasTextSelection, Converter={StaticResource Visible}}">
                        <TextBlock x:Name="TextTitle" Text="{Binding TextTitle}" FontWeight="Medium" Margin="0,0,0,12" />
                        <TextBox x:Name="TextContentBox" Text="{Binding TextContent, UpdateSourceTrigger=LostFocus}" AcceptsReturn="True" TextWrapping="Wrap"
                                 Width="Auto" HorizontalAlignment="Stretch" MinHeight="54" Margin="0,0,0,8" ToolTip="문구. Enter로 줄을 바꾸고, 다른 곳을 눌러 확정합니다." />
                        <DockPanel>
                            <ComboBox x:Name="FontBox" DockPanel.Dock="Right" Width="150" ItemsSource="{x:Static local:MainViewModel.FontNames}"
                                      SelectedItem="{Binding FontName}" Focusable="False" />
                            <TextBlock Text="글꼴" Style="{StaticResource Label}" />
                        </DockPanel>
                        <DockPanel>
                            <CheckBox x:Name="BoldBox" DockPanel.Dock="Right" Content="굵게" IsChecked="{Binding TextBold}" Foreground="#E6E7EA" Focusable="False" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBox x:Name="TextSizeBox" DockPanel.Dock="Right" Text="{Binding TextSize, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="크기" Style="{StaticResource Label}" />
                        </DockPanel>
                        <DockPanel>
                            <TextBox x:Name="TextColorBox" DockPanel.Dock="Right" Width="90" Text="{Binding TextColor, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="글자 색" Style="{StaticResource Label}" ToolTip="#RRGGBB. 앞에 두 자리를 더 쓰면 투명도(#AARRGGBB)." />
                        </DockPanel>
                        <DockPanel>
                            <TextBox x:Name="OutlineWidthBox" DockPanel.Dock="Right" Width="44" Margin="6,0,0,0" Text="{Binding OutlineWidth, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" ToolTip="두께 (0이면 없음)" />
                            <TextBox x:Name="OutlineColorBox" DockPanel.Dock="Right" Width="90" Text="{Binding OutlineColor, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="외곽선" Style="{StaticResource Label}" />
                        </DockPanel>
                        <DockPanel>
                            <TextBox x:Name="ShadowOffsetBox" DockPanel.Dock="Right" Width="44" Margin="6,0,0,0" Text="{Binding ShadowOffset, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" ToolTip="거리 (0이면 없음)" />
                            <TextBox x:Name="ShadowColorBox" DockPanel.Dock="Right" Width="90" Text="{Binding ShadowColor, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="그림자" Style="{StaticResource Label}" />
                        </DockPanel>
                        <DockPanel>
                            <TextBox x:Name="BoxColorBox" DockPanel.Dock="Right" Width="90" Text="{Binding BoxColor, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="배경 박스" Style="{StaticResource Label}" ToolTip="색을 적으면 글자 뒤에 박스를 깝니다. 비우면 없음. 예: #CC000000" />
                        </DockPanel>
                        <DockPanel Visibility="{Binding IsCaptionSelection, Converter={StaticResource Visible}}">
                            <TextBox x:Name="HighlightColorBox" DockPanel.Dock="Right" Width="90" Text="{Binding HighlightColor, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="단어 강조" Style="{StaticResource Label}" ToolTip="색을 적으면 말하는 단어를 그 색으로 강조합니다. 비우면 없음. 예: #FFE14D" />
                        </DockPanel>
                        <DockPanel>
                            <Button x:Name="TextPositionKeyButton" DockPanel.Dock="Right" Content="{Binding PositionKey}" Command="{Binding ToggleKeyframeCommand}" CommandParameter="Position"
                                    Padding="5,2" Margin="4,0,0,0" ToolTip="재생 위치에 키프레임 찍기·지우기" />
                            <TextBox x:Name="TextYBox" DockPanel.Dock="Right" Width="56" Margin="6,0,0,0" Text="{Binding TextY, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" ToolTip="아래로 (픽셀)" />
                            <TextBox x:Name="TextXBox" DockPanel.Dock="Right" Width="56" Text="{Binding TextX, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" ToolTip="오른쪽으로 (픽셀)" />
                            <TextBlock Text="위치 X · Y" Style="{StaticResource Label}" />
                        </DockPanel>
                        <DockPanel>
                            <Button x:Name="ApplyStylePresetButton" DockPanel.Dock="Right" Content="적용" Command="{Binding ApplyStylePresetCommand}" Margin="4,0,0,0" Padding="8,4" />
                            <ComboBox x:Name="StylePresetBox" ItemsSource="{Binding StylePresetNames}" SelectedIndex="{Binding StylePresetIndex}" Focusable="False" />
                        </DockPanel>
                        <Button x:Name="SaveStylePresetButton" Content="이 스타일을 프리셋으로 저장" Click="OnSaveStylePresetClick" Margin="0,0,0,6" />
                        <Button x:Name="DeleteStylePresetButton" Content="고른 프리셋 삭제" Command="{Binding DeleteStylePresetCommand}" Margin="0,0,0,6" />
                        <Button x:Name="ApplyStyleToTrackButton" Content="이 트랙의 모든 자막에 적용" Command="{Binding ApplyStyleToTrackCommand}" Margin="0"
                                Visibility="{Binding IsCaptionSelection, Converter={StaticResource Visible}}"
                                ToolTip="문구와 시간은 그대로 두고 스타일만 복사합니다" />
                    </StackPanel>

                    <!-- 오디오 클립과 그 트랙 -->
                    <StackPanel x:Name="Inspector" Visibility="{Binding HasAudioSelection, Converter={StaticResource Visible}}">
                        <TextBlock x:Name="InspectorTitle" Text="{Binding InspectorTitle}" FontWeight="Medium" Margin="0,0,0,12" />

                        <DockPanel>
                            <Button x:Name="VolumeKeyButton" DockPanel.Dock="Right" Content="{Binding VolumeKey}" Command="{Binding ToggleKeyframeCommand}" CommandParameter="Volume"
                                    Padding="5,2" Margin="4,0,0,0" ToolTip="재생 위치에 키프레임 찍기·지우기 (◆ 여기 있음, ◈ 다른 곳에 있음, ◇ 없음)" />
                            <TextBox x:Name="ClipVolumeBox" DockPanel.Dock="Right" Text="{Binding ClipVolume, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="볼륨 (%)" Style="{StaticResource Label}" ToolTip="0~200. 선택한 오디오 클립 모두에 적용됩니다." />
                        </DockPanel>
                        <DockPanel>
                            <TextBox x:Name="FadeInBox" DockPanel.Dock="Right" Text="{Binding FadeIn, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="페이드 인 (초)" Style="{StaticResource Label}" />
                        </DockPanel>
                        <DockPanel>
                            <TextBox x:Name="FadeOutBox" DockPanel.Dock="Right" Text="{Binding FadeOut, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="페이드 아웃 (초)" Style="{StaticResource Label}" />
                        </DockPanel>
                        <Button x:Name="ApplyToTrackButton" Content="이 트랙의 모든 클립에 적용" Command="{Binding ApplyToTrackCommand}" Margin="0,0,0,16"
                                ToolTip="이 클립의 볼륨과 페이드를 같은 트랙의 모든 클립에 복사합니다" />

                        <TextBlock Text="트랙" FontWeight="Medium" Margin="0,0,0,12" />
                        <DockPanel>
                            <TextBox x:Name="TrackVolumeBox" DockPanel.Dock="Right" Text="{Binding TrackVolume, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="트랙 볼륨 (%)" Style="{StaticResource Label}" />
                        </DockPanel>
                        <DockPanel>
                            <ComboBox x:Name="DuckBox" DockPanel.Dock="Right" Width="110" ItemsSource="{Binding DuckOptions}"
                                      SelectedIndex="{Binding DuckIndex}" Focusable="False" />
                            <TextBlock Text="자동 감쇠 기준" Style="{StaticResource Label}"
                                       ToolTip="고른 트랙(예: 내레이션)에 클립이 있는 동안 이 트랙(예: BGM)의 소리를 줄입니다" />
                        </DockPanel>
                        <DockPanel>
                            <TextBox x:Name="DuckLevelBox" DockPanel.Dock="Right" Text="{Binding DuckLevel, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="감쇠 중 볼륨 (%)" Style="{StaticResource Label}" />
                        </DockPanel>
                    </StackPanel>

                    <!-- 키프레임과 애니메이션 프리셋 -->
                    <StackPanel x:Name="AnimationInspector" Margin="0,16,0,0">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="애니메이션" FontWeight="Medium" Margin="0,0,0,12" />
                        <DockPanel>
                            <Button x:Name="NextKeyButton" DockPanel.Dock="Right" Content="다음 ◆" Command="{Binding JumpKeyframeCommand}" CommandParameter="1" Margin="4,0,0,0" Padding="8,4" />
                            <Button x:Name="PreviousKeyButton" DockPanel.Dock="Right" Content="◆ 이전" Command="{Binding JumpKeyframeCommand}" CommandParameter="-1" Margin="0" Padding="8,4" />
                            <TextBlock Text="키프레임 이동" Style="{StaticResource Label}" />
                        </DockPanel>
                        <DockPanel>
                            <ComboBox x:Name="EasingBox" DockPanel.Dock="Right" Width="130" ItemsSource="{x:Static local:MainViewModel.EasingNames}"
                                      SelectedIndex="{Binding EasingIndex}" Focusable="False" />
                            <TextBlock Text="이징" Style="{StaticResource Label}"
                                       ToolTip="재생 위치의 키프레임에서 다음 키프레임까지 값이 변하는 속도. 새로 찍는 키프레임에도 적용됩니다." />
                        </DockPanel>
                        <DockPanel>
                            <Button x:Name="ApplyPresetButton" DockPanel.Dock="Right" Content="적용" Command="{Binding ApplyPresetCommand}" Margin="4,0,0,0" Padding="8,4" />
                            <ComboBox x:Name="PresetBox" ItemsSource="{Binding PresetNames}" SelectedIndex="{Binding PresetIndex}" Focusable="False" />
                        </DockPanel>
                        <Button x:Name="SavePresetButton" Content="이 움직임을 프리셋으로 저장" Click="OnSavePresetClick" Margin="0,0,0,6"
                                IsEnabled="{Binding HasAnimation}" />
                        <Button x:Name="DeletePresetButton" Content="고른 프리셋 삭제" Command="{Binding DeletePresetCommand}" Margin="0,0,0,6" />
                        <Button x:Name="ClearKeyframesButton" Content="키프레임 모두 지우기" Command="{Binding ClearKeyframesCommand}" Margin="0"
                                IsEnabled="{Binding HasAnimation}" />
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>
        </Grid>

        <!-- 프로젝트가 없을 때 -->
        <StackPanel Grid.Row="1" HorizontalAlignment="Center" VerticalAlignment="Center">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasProject}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <TextBlock Text="NGvid" FontSize="28" FontWeight="Bold" HorizontalAlignment="Center" />
            <TextBlock Text="영상 편집기" Foreground="#A7ACB4" HorizontalAlignment="Center" Margin="0,4,0,24" />
            <Button x:Name="StartNewButton" Content="새 프로젝트" Click="OnNewClick" Style="{StaticResource Primary}" Padding="32,12" Margin="0,0,0,8" />
            <Button x:Name="StartOpenButton" Content="프로젝트 열기" Click="OnOpenClick" Padding="32,12" Margin="0" />
        </StackPanel>

        <!-- 재생 조작 -->
        <Border Grid.Row="2" Background="#17181C" BorderBrush="#2A2D33" BorderThickness="0,1,0,0" Padding="16,10"
                Visibility="{Binding HasProject, Converter={StaticResource Visible}}">
            <DockPanel>
                <StackPanel DockPanel.Dock="Left" Orientation="Horizontal" Margin="0,0,10,0">
                    <Button Content="◀ 1프레임" Command="{Binding StepCommand}" CommandParameter="-1" ToolTip="← 키" />
                    <Button x:Name="PlayButton" Content="{Binding PlayButtonText}" Command="{Binding PlayPauseCommand}"
                            MinWidth="84" Style="{StaticResource Primary}" ToolTip="스페이스 키" />
                    <Button Content="1프레임 ▶" Command="{Binding StepCommand}" CommandParameter="1" ToolTip="→ 키" />
                </StackPanel>

                <local:AudioMeterView x:Name="Meter" DockPanel.Dock="Right" Width="110" Height="14" Margin="12,0,0,0"
                                      VerticalAlignment="Center" ToolTip="재생 중인 소리의 좌·우 크기. 빨간색이면 소리가 찢어집니다." />
                <TextBlock x:Name="TimeLabel" DockPanel.Dock="Right" Text="{Binding TimeText}" Margin="10,0,0,0"
                           VerticalAlignment="Center" FontFamily="Consolas" />

                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" Margin="16,0,0,0">
                    <Button Content="시작점" Command="{Binding SetLoopStartCommand}" ToolTip="현재 위치를 반복 구간의 시작으로 (I 키)" />
                    <Button Content="끝점" Command="{Binding SetLoopEndCommand}" ToolTip="현재 위치를 반복 구간의 끝으로 (O 키)" />
                    <CheckBox x:Name="LoopCheck" Content="구간 반복" IsChecked="{Binding IsLooping}" Focusable="False"
                              Foreground="#E6E7EA" VerticalAlignment="Center" Margin="4,0,8,0" ToolTip="L 키" />
                    <TextBlock Text="{Binding LoopText}" VerticalAlignment="Center" Foreground="#A7ACB4" FontFamily="Consolas" />
                </StackPanel>

                <Slider x:Name="PositionSlider" Minimum="0" Maximum="{Binding LastFrameSeconds}"
                        Value="{Binding PositionSeconds}" Focusable="False"
                        IsMoveToPointEnabled="True" VerticalAlignment="Center" />
            </DockPanel>
        </Border>

        <!-- 타임라인 -->
        <Border Grid.Row="3" Background="#17181C" BorderBrush="#2A2D33" BorderThickness="0,1,0,0"
                Visibility="{Binding HasProject, Converter={StaticResource Visible}}">
            <DockPanel>
                <DockPanel DockPanel.Dock="Top" Margin="12,6">
                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                        <TextBlock Text="확대" Foreground="#A7ACB4" VerticalAlignment="Center" Margin="0,0,8,0" />
                        <Slider x:Name="ZoomSlider" Minimum="0" Maximum="1" Value="{Binding TimelineZoom}" Width="160"
                                Focusable="False" VerticalAlignment="Center" ToolTip="Ctrl + 마우스 휠" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal">
                        <ToggleButton x:Name="SnapButton" Content="스냅" IsChecked="{Binding SnapEnabled}" Style="{StaticResource Toggle}"
                                      ToolTip="재생 위치선과 클립이 클립 경계·마커에 달라붙습니다" />
                        <Button x:Name="AddMarkerButton" Content="마커 추가" Command="{Binding AddMarkerCommand}" ToolTip="M 키" />
                        <Button x:Name="AddTrackButton" Content="＋ 트랙" Click="OnAddTrackClick">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="영상 트랙" Command="{Binding AddTrackCommand}" CommandParameter="video" />
                                    <MenuItem Header="오디오 트랙" Command="{Binding AddTrackCommand}" CommandParameter="audio" />
                                    <MenuItem Header="자막 트랙" Command="{Binding AddTrackCommand}" CommandParameter="caption" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </DockPanel>

                <ScrollBar x:Name="TimelineScroll" DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="180,0,0,0"
                           ValueChanged="OnTimelineScroll" Focusable="False" />

                <!-- shortcut: 트랙이 많아 세로로 스크롤하면 시간 눈금도 함께 올라간다. 불편하면 눈금을 따로 고정한다. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="268" Focusable="False">
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Border Height="28" BorderBrush="#2A2D33" BorderThickness="0,0,1,1" />
                            <ItemsControl x:Name="TrackHeaders" ItemsSource="{Binding Tracks}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="48" Background="#191B1F" BorderBrush="#23262C" BorderThickness="0,0,1,1" Padding="8,0,4,0">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="위로" Click="OnTrackUpClick" />
                                                    <MenuItem Header="아래로" Click="OnTrackDownClick" />
                                                    <MenuItem Header="색상" ItemsSource="{x:Static local:TrackItem.Palette}" Click="OnTrackColorClick">
                                                        <MenuItem.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="60" Height="14" CornerRadius="3" Background="{Binding}" />
                                                            </DataTemplate>
                                                        </MenuItem.ItemTemplate>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="트랙 삭제" Click="OnTrackDeleteClick" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Width="4" Height="24" CornerRadius="2" Background="{Binding Color}" Margin="0,0,6,0" />
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ToggleButton Content="잠금" IsChecked="{Binding Locked}" Style="{StaticResource Toggle}" FontSize="10"
                                                                  ToolTip="잠그면 이 트랙의 클립을 편집할 수 없습니다" />
                                                    <ToggleButton Content="숨김" IsChecked="{Binding Hidden}" Style="{StaticResource Toggle}" FontSize="10"
                                                                  Visibility="{Binding IsVisual, Converter={StaticResource Visible}}"
                                                                  ToolTip="숨기면 화면에 그리지 않습니다" />
                                                    <ToggleButton Content="M" IsChecked="{Binding Muted}" Style="{StaticResource Toggle}" FontSize="10" FontWeight="Bold"
                                                                  Visibility="{Binding IsAudio, Converter={StaticResource Visible}}" ToolTip="음소거" />
                                                    <ToggleButton Content="S" IsChecked="{Binding Solo}" Style="{StaticResource Toggle}" FontSize="10" FontWeight="Bold"
                                                                  Visibility="{Binding IsAudio, Converter={StaticResource Visible}}" ToolTip="솔로: 이 트랙만 듣기" />
                                                </StackPanel>
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown"
                                                         Background="Transparent" Foreground="#E6E7EA" BorderThickness="0" CaretBrush="#E6E7EA"
                                                         FontSize="12" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <local:TimelineView Grid.Column="1" x:Name="Timeline" VerticalAlignment="Top" />
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 알림 -->
        <TextBlock Grid.Row="4" x:Name="StatusLabel" Text="{Binding StatusText}" Foreground="#FFB454" Margin="16,6" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</Window>
