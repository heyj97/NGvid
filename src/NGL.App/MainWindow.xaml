<Window x:Class="NGL.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        xmlns:local="clr-namespace:NGL.App"
        Title="{Binding Title}" Width="1360" Height="860" MinWidth="1100" MinHeight="640"
        Background="{StaticResource Bg}" Foreground="{StaticResource Text}" FontSize="13"
        AllowDrop="True" Drop="OnDrop" PreviewKeyDown="OnPreviewKeyDown">
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="Visible" />

        <!-- 키보드 단축키가 창으로 가도록 이 창의 버튼은 포커스를 받지 않는다. -->
        <Style TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Margin" Value="0,0,6,0" />
        </Style>
        <Style x:Key="MainPrimary" TargetType="Button" BasedOn="{StaticResource Primary}">
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="MainOutline" TargetType="Button" BasedOn="{StaticResource Outline}">
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style x:Key="MainGhost" TargetType="Button" BasedOn="{StaticResource Ghost}">
            <Setter Property="Focusable" Value="False" />
        </Style>
        <Style TargetType="CheckBox" BasedOn="{StaticResource {x:Type CheckBox}}">
            <Setter Property="Focusable" Value="False" />
        </Style>

        <!-- 재생 조작의 아이콘 버튼 -->
        <Style x:Key="Transport" TargetType="Button" BasedOn="{StaticResource MainGhost}">
            <Setter Property="Width" Value="36" />
            <Setter Property="Height" Value="36" />
            <Setter Property="Margin" Value="2,0" />
        </Style>

        <!-- 글자만 있는 작은 버튼 -->
        <Style x:Key="Link" TargetType="Button" BasedOn="{StaticResource MainGhost}">
            <Setter Property="Width" Value="Auto" />
            <Setter Property="Height" Value="Auto" />
            <Setter Property="Padding" Value="6,3" />
            <Setter Property="Margin" Value="0" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="12" />
        </Style>

        <!-- 보관함의 영상·사운드·이미지 탭 -->
        <Style x:Key="Tab" TargetType="RadioButton">
            <Setter Property="Focusable" Value="False" />
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="RadioButton">
                        <Border x:Name="Back" Background="Transparent" CornerRadius="6" Padding="10,6" Margin="0,0,4,0">
                            <ContentPresenter />
                        </Border>
                        <ControlTemplate.Triggers>
                            <Trigger Property="IsChecked" Value="True">
                                <Setter TargetName="Back" Property="Background" Value="{StaticResource Chip}" />
                                <Setter Property="Foreground" Value="{StaticResource Text}" />
                            </Trigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" MinHeight="260" />
            <RowDefinition x:Name="TimelineRow" Height="282" MinHeight="140" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- 상단: 메뉴, 프로젝트 이름과 시퀀스 규격. 실행 취소·다시 실행은 편집 메뉴에, 내보내기는 파일 메뉴에 있다. -->
        <Border Grid.Row="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="8,0">
            <DockPanel>
                <Menu DockPanel.Dock="Left" Background="Transparent" VerticalAlignment="Center" Focusable="False">
                    <MenuItem x:Name="FileMenu" Header="파일" Padding="10,5">
                        <MenuItem Header="새 프로젝트" InputGestureText="Ctrl+N" Click="OnNewClick" />
                        <MenuItem Header="링크로 프로젝트 시작" Click="OnNewFromLinkClick" />
                        <MenuItem Header="열기" InputGestureText="Ctrl+O" Click="OnOpenClick" />
                        <MenuItem Header="저장" InputGestureText="Ctrl+S" Command="{Binding SaveCommand}" />
                        <Separator />
                        <MenuItem Header="미디어 가져오기" InputGestureText="Ctrl+I" Click="OnImportClick" IsEnabled="{Binding HasProject}" />
                        <MenuItem x:Name="ExportItem" Header="내보내기" InputGestureText="Ctrl+E" Click="OnExportClick" IsEnabled="{Binding HasProject}" />
                        <Separator />
                        <MenuItem x:Name="RestoreItem" Header="백업에서 복구…" Click="OnRestoreClick" IsEnabled="{Binding HasProject}" />
                        <MenuItem x:Name="SettingsItem" Header="설정…" Click="OnSettingsClick" />
                    </MenuItem>
                    <MenuItem x:Name="EditMenu" Header="편집" Padding="10,5" IsEnabled="{Binding HasProject}">
                        <MenuItem x:Name="UndoItem" Header="{Binding UndoText}" InputGestureText="Ctrl+Z" Command="{Binding UndoCommand}" />
                        <MenuItem x:Name="RedoItem" Header="{Binding RedoText}" InputGestureText="Ctrl+Y" Command="{Binding RedoCommand}" />
                        <Separator />
                        <MenuItem x:Name="SplitItem" Header="재생 위치에서 분할" InputGestureText="Ctrl+K" Command="{Binding SplitCommand}" />
                        <MenuItem x:Name="DeleteItem" Header="삭제" InputGestureText="Delete" Command="{Binding DeleteCommand}" />
                        <MenuItem x:Name="RippleDeleteItem" Header="리플 삭제" InputGestureText="Shift+Delete" Command="{Binding RippleDeleteCommand}" />
                        <Separator />
                        <MenuItem x:Name="CopyItem" Header="복사" InputGestureText="Ctrl+C" Command="{Binding CopyCommand}" />
                        <MenuItem x:Name="PasteItem" Header="붙여넣기" InputGestureText="Ctrl+V" Command="{Binding PasteCommand}" />
                        <MenuItem x:Name="PastePropertiesItem" Header="속성 붙여넣기" InputGestureText="Ctrl+Alt+V" Command="{Binding PastePropertiesCommand}"
                                  ToolTip="복사한 클립의 변형·볼륨·페이드 등을 선택한 클립에 입힙니다" />
                        <MenuItem x:Name="SelectAllItem" Header="모두 선택" InputGestureText="Ctrl+A" Command="{Binding SelectAllCommand}" />
                        <Separator />
                        <MenuItem x:Name="GroupItem" Header="그룹" InputGestureText="Ctrl+G" Command="{Binding GroupCommand}" />
                        <MenuItem x:Name="UngroupItem" Header="그룹 해제" InputGestureText="Ctrl+Shift+G" Command="{Binding UngroupCommand}" />
                        <MenuItem x:Name="LinkItem" Header="영상·오디오 연결" Command="{Binding LinkCommand}" />
                        <MenuItem x:Name="UnlinkItem" Header="영상·오디오 분리" Command="{Binding UnlinkCommand}" />
                        <Separator />
                        <MenuItem x:Name="FreezeFrameItem" Header="정지 프레임 만들기" Command="{Binding FreezeFrameCommand}" />
                    </MenuItem>
                    <MenuItem x:Name="ViewMenu" Header="보기" Padding="10,5" IsEnabled="{Binding HasProject}">
                        <MenuItem x:Name="SafeAreaItem" Header="안전 영역 표시" IsCheckable="True" IsChecked="{Binding ShowSafeArea}" />
                        <MenuItem x:Name="CaptionListItem" Header="텍스트 목록…" Click="OnCaptionListClick" />
                        <MenuItem x:Name="ResetLayoutItem" Header="레이아웃 초기화" Click="OnResetLayoutClick"
                                  ToolTip="보관함·속성 패널의 너비와 타임라인의 높이를 처음 크기로 되돌립니다" />
                    </MenuItem>
                </Menu>

                <TextBlock x:Name="AudioWarningLabel" DockPanel.Dock="Right" Text="{Binding AudioWarning}"
                           Margin="10,0" VerticalAlignment="Center" Foreground="#FFB454" />

                <StackPanel Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock x:Name="ProjectNameLabel" Text="{Binding Project.Name}" FontWeight="Medium" VerticalAlignment="Center" />
                    <Border BorderBrush="{StaticResource InputLine}" BorderThickness="1" CornerRadius="10" Padding="8,2" Margin="8,0,0,0"
                            Visibility="{Binding HasProject, Converter={StaticResource Visible}}">
                        <TextBlock x:Name="SequenceLabel" Text="{Binding SequenceText}" FontSize="12" Foreground="{StaticResource Muted}" />
                    </Border>
                </StackPanel>
            </DockPanel>
        </Border>

        <!-- 가운데: 보관함 + 미리보기 + 속성 패널 -->
        <Grid Grid.Row="1" Visibility="{Binding HasProject, Converter={StaticResource Visible}}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition x:Name="LibraryColumn" Width="280" MinWidth="200" MaxWidth="600" />
                <ColumnDefinition Width="*" MinWidth="420" />
                <ColumnDefinition x:Name="InspectorColumn" Width="300" MinWidth="240" MaxWidth="600" />
            </Grid.ColumnDefinitions>

            <!-- 리소스 보관함 -->
            <Border Grid.Column="0" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,0">
                <DockPanel>
                    <DockPanel DockPanel.Dock="Top" Margin="12,12,12,8">
                        <Button x:Name="ImportButton" DockPanel.Dock="Right" Click="OnImportClick" Width="32" Height="32" Padding="0" Margin="0"
                                AutomationProperties.Name="가져오기" ToolTip="미디어 가져오기 (Ctrl+I). 파일을 창에 끌어 놓아도 됩니다.">
                            <Path Style="{StaticResource Icon}" Data="M7 2 V12 M2 7 H12" Width="14" Height="14" />
                        </Button>
                        <StackPanel Orientation="Horizontal">
                            <RadioButton x:Name="VideoTab" Content="영상" Style="{StaticResource Tab}" Tag="0" Checked="OnTabChecked" IsChecked="True" />
                            <RadioButton x:Name="SoundTab" Content="사운드" Style="{StaticResource Tab}" Checked="OnTabChecked" Tag="1" />
                            <RadioButton x:Name="ImageTab" Content="이미지" Style="{StaticResource Tab}" Checked="OnTabChecked" Tag="2" />
                        </StackPanel>
                    </DockPanel>

                    <!-- 사라진 원본 안내 -->
                    <Border x:Name="MissingBanner" DockPanel.Dock="Top" Background="#3A2A1A" Margin="12,0,12,8" Padding="10,5" CornerRadius="6">
                        <Border.Style>
                            <Style TargetType="Border">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding MissingCount}" Value="0">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Border.Style>
                        <DockPanel>
                            <Button DockPanel.Dock="Right" Content="폴더에서 찾기" Click="OnRelinkFolderClick" Margin="8,0,0,0" />
                            <TextBlock VerticalAlignment="Center" Foreground="#FFB454" TextWrapping="Wrap">
                                <Run Text="원본 파일" /><Run x:Name="MissingCountRun" Text="{Binding MissingCount, Mode=OneWay}" /><Run Text="개가 없습니다." />
                            </TextBlock>
                        </DockPanel>
                    </Border>

                    <!-- 끌어 놓을 곳을 알려 주고, 누르면 파일을 고르는 창을 연다. -->
                    <Button x:Name="DropHintButton" DockPanel.Dock="Bottom" Margin="12,0,12,12" Click="OnImportClick" Cursor="Hand" Focusable="False"
                            ToolTip="눌러서 파일을 고를 수도 있습니다 (Ctrl+I)">
                        <Button.Template>
                            <ControlTemplate TargetType="Button">
                                <Grid Background="Transparent">
                                    <Rectangle x:Name="Edge" Stroke="#3A3E46" StrokeDashArray="4 3" RadiusX="8" RadiusY="8" />
                                    <TextBlock x:Name="Hint" Text="파일을 여기로 끌어 놓으세요" Foreground="{StaticResource Muted}" FontSize="12"
                                               HorizontalAlignment="Center" Margin="0,16" />
                                </Grid>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Edge" Property="Stroke" Value="{StaticResource Accent}" />
                                        <Setter TargetName="Hint" Property="Foreground" Value="{StaticResource Text}" />
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Button.Template>
                    </Button>

                    <ListBox x:Name="AssetList" ItemsSource="{Binding VisibleAssets}" Background="Transparent" BorderThickness="0"
                             ScrollViewer.HorizontalScrollBarVisibility="Disabled" Padding="6,0" Focusable="False">
                        <ListBox.ItemsPanel>
                            <ItemsPanelTemplate>
                                <UniformGrid Columns="2" VerticalAlignment="Top" />
                            </ItemsPanelTemplate>
                        </ListBox.ItemsPanel>
                        <ListBox.ItemContainerStyle>
                            <Style TargetType="ListBoxItem" BasedOn="{StaticResource PlainItem}">
                                <Setter Property="Padding" Value="5,4,5,6" />
                            </Style>
                        </ListBox.ItemContainerStyle>
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <StackPanel.ContextMenu>
                                        <ContextMenu>
                                            <MenuItem Header="타임라인에 추가" Click="OnAddToTimelineClick" />
                                            <MenuItem Header="다시 연결…" Click="OnRelinkClick" />
                                            <MenuItem Header="프록시 만들기" Click="OnBuildProxyClick"
                                                      ToolTip="미리보기용 작은 사본을 만듭니다(영상만). 내보내기는 언제나 원본을 씁니다." />
                                        </ContextMenu>
                                    </StackPanel.ContextMenu>
                                    <Border Height="70" CornerRadius="6" Background="{StaticResource Input}" BorderBrush="{StaticResource Line}" BorderThickness="1"
                                            ClipToBounds="True" MouseMove="OnAssetMouseMove" ToolTip="타임라인으로 끌어 놓을 수 있습니다">
                                        <Grid>
                                            <Image Source="{Binding Thumbnail}" Stretch="UniformToFill" />
                                            <TextBlock Text="원본 없음" Foreground="#FF7A7A" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                       Visibility="{Binding IsMissing, Converter={StaticResource Visible}}" />
                                            <Border HorizontalAlignment="Right" VerticalAlignment="Bottom" Margin="4" Padding="5,1"
                                                    CornerRadius="4" Background="#B3000000">
                                                <TextBlock Text="{Binding DurationText}" FontFamily="{StaticResource Mono}" FontSize="11" />
                                            </Border>
                                            <Button Content="＋" ToolTip="타임라인 맨 뒤에 추가" HorizontalAlignment="Right" VerticalAlignment="Top"
                                                    Margin="4" Padding="6,1" Background="#B3000000"
                                                    Command="{Binding DataContext.AddToTimelineCommand, RelativeSource={RelativeSource AncestorType=ListBox}}"
                                                    CommandParameter="{Binding}" />
                                        </Grid>
                                    </Border>
                                    <!-- 이름을 고치면 이 원본을 쓰는 모든 클립에 반영된다. Enter 또는 다른 곳 클릭으로 확정. -->
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown"
                                             Background="Transparent" Foreground="{StaticResource Text2}" BorderThickness="0" Padding="0"
                                             FontSize="12" Margin="0,6,0,0" ToolTip="{Binding Name}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                </DockPanel>
            </Border>

            <!-- 미리보기와 재생 조작 -->
            <Grid Grid.Column="1">
                <Grid.RowDefinitions>
                    <RowDefinition Height="*" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <!-- 선택한 클립을 끌어 옮기고 마우스 휠로 크기를 바꾼다. -->
                <skia:SKGLElement Grid.Row="0" x:Name="Preview" PaintSurface="OnPaintSurface"
                                  MouseLeftButtonDown="OnPreviewMouseDown" MouseMove="OnPreviewMouseMove"
                                  MouseLeftButtonUp="OnPreviewMouseUp" MouseWheel="OnPreviewWheel" />

                <Slider Grid.Row="1" x:Name="PositionSlider" Minimum="0" Maximum="{Binding LastFrameSeconds}" Margin="16,0"
                        Value="{Binding PositionSeconds}" Focusable="False" IsMoveToPointEnabled="True" />

                <DockPanel Grid.Row="2" Margin="16,6,16,10">
                    <TextBlock x:Name="TimeLabel" DockPanel.Dock="Left" Text="{Binding PositionText}" Width="92"
                               VerticalAlignment="Center" FontFamily="{StaticResource Mono}" />

                    <CheckBox x:Name="SafeAreaBox" DockPanel.Dock="Right" Content="안전 영역" IsChecked="{Binding ShowSafeArea}"
                              Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,0,0" />
                    <ComboBox x:Name="QualityBox" DockPanel.Dock="Right" SelectedIndex="{Binding QualityIndex}" Focusable="False"
                              Width="70" VerticalAlignment="Center" ToolTip="미리보기 화질. 낮추면 재생이 가벼워집니다.">
                        <ComboBoxItem Content="전체" />
                        <ComboBoxItem Content="1/2" />
                        <ComboBoxItem Content="1/4" />
                    </ComboBox>
                    <TextBlock DockPanel.Dock="Right" Text="화질" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="12,0,6,0" />
                    <TextBlock x:Name="TotalLabel" DockPanel.Dock="Right" Text="{Binding TotalText}" VerticalAlignment="Center"
                               FontFamily="{StaticResource Mono}" Foreground="{StaticResource Muted}" />

                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Center">
                        <Button Style="{StaticResource Transport}" Command="{Binding GoToCommand}" CommandParameter="start"
                                AutomationProperties.Name="처음으로" ToolTip="처음으로">
                            <Path Style="{StaticResource Icon}" Data="M3 3 V13 M13 3 L6 8 L13 13 Z" />
                        </Button>
                        <Button Style="{StaticResource Transport}" Command="{Binding StepCommand}" CommandParameter="-1"
                                AutomationProperties.Name="이전 프레임" ToolTip="이전 프레임 (←)">
                            <Path Style="{StaticResource Icon}" Data="M10 3 L5 8 L10 13" />
                        </Button>
                        <Button x:Name="PlayButton" Command="{Binding PlayPauseCommand}" Width="44" Height="44" Margin="4,0" Focusable="False"
                                AutomationProperties.Name="{Binding PlayButtonText}" ToolTip="재생·일시정지 (스페이스)">
                            <Button.Template>
                                <ControlTemplate TargetType="Button">
                                    <Grid>
                                        <Ellipse x:Name="Back" Fill="{StaticResource Text}" />
                                        <Path x:Name="Glyph" Data="M5 3 L13 8 L5 13 Z" Fill="#101114" Width="16" Height="16" Margin="2,0,0,0" />
                                    </Grid>
                                    <ControlTemplate.Triggers>
                                        <DataTrigger Binding="{Binding IsPlaying}" Value="True">
                                            <Setter TargetName="Glyph" Property="Data" Value="M4 3 H7 V13 H4 Z M9 3 H12 V13 H9 Z" />
                                            <Setter TargetName="Glyph" Property="Margin" Value="0" />
                                        </DataTrigger>
                                        <Trigger Property="IsMouseOver" Value="True">
                                            <Setter TargetName="Back" Property="Fill" Value="White" />
                                        </Trigger>
                                    </ControlTemplate.Triggers>
                                </ControlTemplate>
                            </Button.Template>
                        </Button>
                        <Button Style="{StaticResource Transport}" Command="{Binding StepCommand}" CommandParameter="1"
                                AutomationProperties.Name="다음 프레임" ToolTip="다음 프레임 (→)">
                            <Path Style="{StaticResource Icon}" Data="M6 3 L11 8 L6 13" />
                        </Button>
                        <Button Style="{StaticResource Transport}" Command="{Binding GoToCommand}" CommandParameter="end"
                                AutomationProperties.Name="끝으로" ToolTip="끝으로">
                            <Path Style="{StaticResource Icon}" Data="M13 3 V13 M3 3 L10 8 L3 13 Z" />
                        </Button>
                        <ToggleButton x:Name="LoopCheck" IsChecked="{Binding IsLooping}" Style="{StaticResource Toggle}" Width="36" Height="36" Margin="2,0"
                                      Foreground="{StaticResource Text2}" AutomationProperties.Name="구간 반복" ToolTip="구간 반복 (L)">
                            <Path Data="M3 7 V6 A2 2 0 0 1 5 4 H12 L10 2 M13 9 V10 A2 2 0 0 1 11 12 H4 L6 14" Width="16" Height="16" StrokeThickness="1.6">
                                <Path.Style>
                                    <Style TargetType="Path">
                                        <Setter Property="Stroke" Value="{StaticResource Text2}" />
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding IsLooping}" Value="True">
                                                <Setter Property="Stroke" Value="{StaticResource Accent}" />
                                            </DataTrigger>
                                        </Style.Triggers>
                                    </Style>
                                </Path.Style>
                            </Path>
                        </ToggleButton>
                        <Button Content="시작점" Style="{StaticResource Link}" Command="{Binding SetLoopStartCommand}" VerticalAlignment="Center"
                                ToolTip="현재 위치를 반복 구간의 시작으로 (I)" />
                        <Button Content="끝점" Style="{StaticResource Link}" Command="{Binding SetLoopEndCommand}" VerticalAlignment="Center"
                                ToolTip="현재 위치를 반복 구간의 끝으로 (O)" />
                        <TextBlock Text="{Binding LoopText}" VerticalAlignment="Center" Foreground="{StaticResource Dim}"
                                   FontFamily="{StaticResource Mono}" FontSize="11" Margin="6,0,0,0"
                                   Visibility="{Binding IsLooping, Converter={StaticResource Visible}}" />
                    </StackPanel>
                </DockPanel>
            </Grid>

            <!-- 속성 패널: 값은 Enter나 다른 곳 클릭으로 확정한다. -->
            <Border Grid.Column="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0">
                <Border.Resources>
                    <Style TargetType="TextBox" BasedOn="{StaticResource {x:Type TextBox}}">
                        <Setter Property="Padding" Value="8,4" />
                        <Setter Property="FontFamily" Value="{StaticResource Mono}" />
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="Width" Value="76" />
                        <Setter Property="HorizontalAlignment" Value="Right" />
                    </Style>
                    <Style TargetType="ComboBox" BasedOn="{StaticResource {x:Type ComboBox}}">
                        <Setter Property="MinWidth" Value="110" />
                    </Style>
                    <Style x:Key="Label" TargetType="TextBlock">
                        <Setter Property="Foreground" Value="{StaticResource Muted}" />
                        <Setter Property="VerticalAlignment" Value="Center" />
                    </Style>
                    <Style x:Key="Title" TargetType="TextBlock">
                        <Setter Property="FontSize" Value="12" />
                        <Setter Property="FontWeight" Value="Bold" />
                        <Setter Property="Margin" Value="0,0,0,10" />
                    </Style>
                    <Style x:Key="Divider" TargetType="Border">
                        <Setter Property="Height" Value="1" />
                        <Setter Property="Background" Value="{StaticResource Line}" />
                        <Setter Property="Margin" Value="-16,4,-16,12" />
                    </Style>
                    <Style TargetType="DockPanel">
                        <Setter Property="Margin" Value="0,0,0,10" />
                    </Style>
                    <!-- 키프레임 버튼: ◆ 여기 있음, ◈ 다른 곳에 있음, ◇ 없음 -->
                    <Style x:Key="Key" TargetType="Button" BasedOn="{StaticResource MainGhost}">
                        <Setter Property="Width" Value="28" />
                        <Setter Property="Height" Value="28" />
                        <Setter Property="Margin" Value="4,0,-6,0" />
                        <Setter Property="Foreground" Value="{StaticResource Accent}" />
                        <Style.Triggers>
                            <Trigger Property="Content" Value="◇">
                                <Setter Property="Foreground" Value="#5C6370" />
                            </Trigger>
                        </Style.Triggers>
                    </Style>
                </Border.Resources>
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                <StackPanel Margin="16,12">
                    <TextBlock Text="클립을 선택하면 여기에서 속성을 바꿀 수 있습니다." Foreground="{StaticResource Dim}" TextWrapping="Wrap"
                               Visibility="{Binding HasNoSelection, Converter={StaticResource Visible}}" />

                    <StackPanel x:Name="VisualInspector" Visibility="{Binding HasVisualSelection, Converter={StaticResource Visible}}">
                        <TextBlock x:Name="VisualTitle" Text="{Binding VisualTitle}" Style="{StaticResource Title}" />
                        <DockPanel>
                            <Button x:Name="PositionKeyButton" DockPanel.Dock="Right" Content="{Binding PositionKey}" Command="{Binding ToggleKeyframeCommand}" CommandParameter="Position"
                                    Style="{StaticResource Key}" ToolTip="재생 위치에 키프레임 찍기·지우기 (◆ 여기 있음, ◈ 다른 곳에 있음, ◇ 없음)" />
                            <TextBox x:Name="PositionYBox" DockPanel.Dock="Right" Width="56" Margin="6,0,0,0" Text="{Binding PositionY, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" ToolTip="아래로 (픽셀)" />
                            <TextBox x:Name="PositionXBox" DockPanel.Dock="Right" Width="56" Text="{Binding PositionX, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" ToolTip="오른쪽으로 (픽셀)" />
                            <TextBlock Text="위치 X · Y" Style="{StaticResource Label}" ToolTip="화면 가운데에서 옮긴 거리. 미리보기에서 끌어도 됩니다." />
                        </DockPanel>
                        <UniformGrid Columns="2" Margin="0,-4,0,10">
                            <local:NumberSlider x:Name="PositionXSlider" Text="{Binding PositionX}" Minimum="-2000" Maximum="2000" TickFrequency="1" Margin="0,0,6,0" />
                            <local:NumberSlider x:Name="PositionYSlider" Text="{Binding PositionY}" Minimum="-2000" Maximum="2000" TickFrequency="1" Margin="6,0,0,0" />
                        </UniformGrid>
                        <DockPanel>
                            <Button x:Name="ScaleKeyButton" DockPanel.Dock="Right" Content="{Binding ScaleKey}" Command="{Binding ToggleKeyframeCommand}" CommandParameter="Scale"
                                    Style="{StaticResource Key}" ToolTip="재생 위치에 키프레임 찍기·지우기 (◆ 여기 있음, ◈ 다른 곳에 있음, ◇ 없음)" />
                            <TextBox x:Name="ScaleBox" DockPanel.Dock="Right" Text="{Binding ScalePercent, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="크기 (%)" Style="{StaticResource Label}" ToolTip="10~400. 미리보기에서 마우스 휠로도 바꿀 수 있습니다." />
                        </DockPanel>
                        <local:NumberSlider x:Name="ScalePercentSlider" Text="{Binding ScalePercent}" Minimum="10" Maximum="400" TickFrequency="1" Margin="0,-4,0,10" />
                        <DockPanel>
                            <Button x:Name="RotationKeyButton" DockPanel.Dock="Right" Content="{Binding RotationKey}" Command="{Binding ToggleKeyframeCommand}" CommandParameter="Rotation"
                                    Style="{StaticResource Key}" ToolTip="재생 위치에 키프레임 찍기·지우기 (◆ 여기 있음, ◈ 다른 곳에 있음, ◇ 없음)" />
                            <TextBox x:Name="RotationBox" DockPanel.Dock="Right" Text="{Binding RotationDegrees, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="회전 (도)" Style="{StaticResource Label}" />
                        </DockPanel>
                        <local:NumberSlider x:Name="RotationDegreesSlider" Text="{Binding RotationDegrees}" Minimum="-180" Maximum="180" TickFrequency="1" Margin="0,-4,0,10" />
                        <DockPanel>
                            <Button x:Name="OpacityKeyButton" DockPanel.Dock="Right" Content="{Binding OpacityKey}" Command="{Binding ToggleKeyframeCommand}" CommandParameter="Opacity"
                                    Style="{StaticResource Key}" ToolTip="재생 위치에 키프레임 찍기·지우기 (◆ 여기 있음, ◈ 다른 곳에 있음, ◇ 없음)" />
                            <TextBox x:Name="OpacityBox" DockPanel.Dock="Right" Text="{Binding OpacityPercent, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="불투명도 (%)" Style="{StaticResource Label}" />
                        </DockPanel>
                        <local:NumberSlider x:Name="OpacityPercentSlider" Text="{Binding OpacityPercent}" Minimum="0" Maximum="100" TickFrequency="1" Margin="0,-4,0,10" />
                        <DockPanel>
                            <ComboBox x:Name="BlendBox" DockPanel.Dock="Right" Width="110" ItemsSource="{x:Static local:MainViewModel.BlendNames}"
                                      SelectedIndex="{Binding BlendIndex}" Focusable="False" />
                            <TextBlock Text="블렌드 모드" Style="{StaticResource Label}" />
                        </DockPanel>
                        <DockPanel>
                            <ComboBox x:Name="FitBox" DockPanel.Dock="Right" Width="150" ItemsSource="{x:Static local:MainViewModel.FitNames}"
                                      SelectedIndex="{Binding FitIndex}" Focusable="False" />
                            <TextBlock Text="화면 맞춤" Style="{StaticResource Label}" />
                        </DockPanel>
                        <TextBlock Text="자르기 (%)  왼쪽 · 위 · 오른쪽 · 아래" Style="{StaticResource Label}" Margin="0,4,0,6" />
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,8">
                            <TextBox x:Name="CropLeftBox" Width="52" Margin="0,0,6,0" Text="{Binding CropLeft, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBox x:Name="CropTopBox" Width="52" Margin="0,0,6,0" Text="{Binding CropTop, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBox x:Name="CropRightBox" Width="52" Margin="0,0,6,0" Text="{Binding CropRight, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBox x:Name="CropBottomBox" Width="52" Text="{Binding CropBottom, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                        </StackPanel>
                        <UniformGrid Columns="2" Margin="0,-2,0,10">
                            <local:NumberSlider x:Name="CropLeftSlider" Text="{Binding CropLeft}" Maximum="95" Margin="0,0,6,4" ToolTip="왼쪽" />
                            <local:NumberSlider x:Name="CropTopSlider" Text="{Binding CropTop}" Maximum="95" Margin="6,0,0,4" ToolTip="위" />
                            <local:NumberSlider x:Name="CropRightSlider" Text="{Binding CropRight}" Maximum="95" Margin="0,0,6,0" ToolTip="오른쪽" />
                            <local:NumberSlider x:Name="CropBottomSlider" Text="{Binding CropBottom}" Maximum="95" Margin="6,0,0,0" ToolTip="아래" />
                        </UniformGrid>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,10">
                            <CheckBox x:Name="FlipHorizontalBox" Content="좌우 뒤집기" IsChecked="{Binding FlipHorizontal}" Focusable="False" Margin="0,0,14,0" />
                            <CheckBox x:Name="FlipVerticalBox" Content="상하 뒤집기" IsChecked="{Binding FlipVertical}" Focusable="False" />
                        </StackPanel>
                        <Button x:Name="ResetTransformButton" Content="변형 초기화" Command="{Binding ResetTransformCommand}" Margin="0"
                                ToolTip="위치·크기·회전·자르기·뒤집기를 처음 상태로 되돌립니다" />

                        <!-- 전환, 효과, 색보정 -->
                        <Border Style="{StaticResource Divider}" />
                        <TextBlock Text="전환" Style="{StaticResource Title}" />
                        <DockPanel>
                            <TextBox x:Name="TransitionSecondsBox" DockPanel.Dock="Right" Width="44" Margin="6,0,0,0" Text="{Binding TransitionSeconds, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" ToolTip="길이 (초)" />
                            <ComboBox x:Name="TransitionBox" DockPanel.Dock="Right" Width="130" ItemsSource="{x:Static local:MainViewModel.TransitionNames}"
                                      SelectedIndex="{Binding TransitionIndex}" Focusable="False" />
                            <TextBlock Text="시작" Style="{StaticResource Label}"
                                       ToolTip="앞 클립에서 이 클립으로 넘어올 때의 효과. 같은 트랙에서 바로 앞에 붙은 클립과 이어집니다." />
                        </DockPanel>
                        <local:NumberSlider x:Name="TransitionSecondsSlider" Text="{Binding TransitionSeconds}" Minimum="0.1" Maximum="3" TickFrequency="0.1" Margin="0,-4,0,10" />

                        <Border Style="{StaticResource Divider}" />
                        <TextBlock Text="효과" Style="{StaticResource Title}" />
                        <DockPanel>
                            <TextBox x:Name="BlurBox" DockPanel.Dock="Right" Text="{Binding BlurAmount, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="흐림 (0~100)" Style="{StaticResource Label}" />
                        </DockPanel>
                        <local:NumberSlider x:Name="BlurAmountSlider" Text="{Binding BlurAmount}" Minimum="0" Maximum="100" TickFrequency="1" Margin="0,-4,0,10" />
                        <DockPanel>
                            <TextBox x:Name="SharpenBox" DockPanel.Dock="Right" Text="{Binding SharpenPercent, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="선명하게 (%)" Style="{StaticResource Label}" />
                        </DockPanel>
                        <local:NumberSlider x:Name="SharpenPercentSlider" Text="{Binding SharpenPercent}" Minimum="0" Maximum="100" TickFrequency="1" Margin="0,-4,0,10" />
                        <DockPanel>
                            <TextBox x:Name="VignetteBox" DockPanel.Dock="Right" Text="{Binding VignettePercent, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="비네팅 (%)" Style="{StaticResource Label}" ToolTip="가장자리를 어둡게 합니다" />
                        </DockPanel>
                        <local:NumberSlider x:Name="VignettePercentSlider" Text="{Binding VignettePercent}" Minimum="0" Maximum="100" TickFrequency="1" Margin="0,-4,0,10" />

                        <Border Style="{StaticResource Divider}" />
                        <TextBlock Text="색보정" Style="{StaticResource Title}" ToolTip="-100~100, 0이 원래 그대로" />
                        <DockPanel>
                            <TextBox x:Name="ExposureBox" DockPanel.Dock="Right" Text="{Binding ExposureStops, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="노출 (-2~2)" Style="{StaticResource Label}" ToolTip="1마다 밝기가 두 배" />
                        </DockPanel>
                        <local:NumberSlider x:Name="ExposureStopsSlider" Text="{Binding ExposureStops}" Minimum="-2" Maximum="2" TickFrequency="0.1" Margin="0,-4,0,10" />
                        <DockPanel>
                            <TextBox x:Name="BrightnessBox" DockPanel.Dock="Right" Text="{Binding BrightnessPercent, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="밝기 (%)" Style="{StaticResource Label}" />
                        </DockPanel>
                        <local:NumberSlider x:Name="BrightnessPercentSlider" Text="{Binding BrightnessPercent}" Minimum="-100" Maximum="100" TickFrequency="1" Margin="0,-4,0,10" />
                        <DockPanel>
                            <TextBox x:Name="ContrastBox" DockPanel.Dock="Right" Text="{Binding ContrastPercent, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="대비 (%)" Style="{StaticResource Label}" />
                        </DockPanel>
                        <local:NumberSlider x:Name="ContrastPercentSlider" Text="{Binding ContrastPercent}" Minimum="-100" Maximum="100" TickFrequency="1" Margin="0,-4,0,10" />
                        <DockPanel>
                            <TextBox x:Name="SaturationBox" DockPanel.Dock="Right" Text="{Binding SaturationPercent, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="채도 (%)" Style="{StaticResource Label}" ToolTip="-100이면 흑백" />
                        </DockPanel>
                        <local:NumberSlider x:Name="SaturationPercentSlider" Text="{Binding SaturationPercent}" Minimum="-100" Maximum="100" TickFrequency="1" Margin="0,-4,0,10" />
                        <DockPanel>
                            <TextBox x:Name="TemperatureBox" DockPanel.Dock="Right" Text="{Binding TemperaturePercent, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="색온도 (%)" Style="{StaticResource Label}" ToolTip="양수는 따뜻하게, 음수는 차갑게" />
                        </DockPanel>
                        <local:NumberSlider x:Name="TemperaturePercentSlider" Text="{Binding TemperaturePercent}" Minimum="-100" Maximum="100" TickFrequency="1" Margin="0,-4,0,10" />
                        <DockPanel>
                            <Button x:Name="ClearLutButton" DockPanel.Dock="Right" Content="해제" Command="{Binding ClearLutCommand}" Margin="4,0,0,0" Padding="8,4" IsEnabled="{Binding HasLut}" />
                            <Button x:Name="ImportLutButton" DockPanel.Dock="Right" Content="불러오기" Click="OnImportLutClick" Margin="4,0,0,0" Padding="8,4" ToolTip=".cube 파일을 골라 색감을 적용합니다" />
                            <TextBlock VerticalAlignment="Center" TextTrimming="CharacterEllipsis">
                                <Run Text="LUT  " Foreground="#A7ACB4" /><Run x:Name="LutNameRun" Text="{Binding LutName, Mode=OneWay}" />
                            </TextBlock>
                        </DockPanel>
                        <Button x:Name="ResetEffectsButton" Content="효과·색보정 초기화" Command="{Binding ResetEffectsCommand}" Margin="0" />

                        <!-- 크로마키 -->
                        <Border Style="{StaticResource Divider}" />
                        <TextBlock Text="크로마키" Style="{StaticResource Title}" />
                        <DockPanel>
                            <TextBox x:Name="KeyColorBox" DockPanel.Dock="Right" Width="90" Text="{Binding KeyColor, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="지울 색" Style="{StaticResource Label}" ToolTip="이 색을 투명하게 만듭니다. 그린스크린은 #00FF00, 블루스크린은 #0000FF. 비우면 끕니다." />
                        </DockPanel>
                        <DockPanel>
                            <TextBox x:Name="KeyToleranceBox" DockPanel.Dock="Right" Text="{Binding KeyTolerancePercent, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="허용 범위 (%)" Style="{StaticResource Label}" ToolTip="클수록 비슷한 색까지 지웁니다" />
                        </DockPanel>
                        <local:NumberSlider x:Name="KeyTolerancePercentSlider" Text="{Binding KeyTolerancePercent}" Minimum="0" Maximum="100" TickFrequency="1" Margin="0,-4,0,10" />
                        <DockPanel>
                            <TextBox x:Name="KeySoftnessBox" DockPanel.Dock="Right" Text="{Binding KeySoftnessPercent, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="가장자리 부드럽게 (%)" Style="{StaticResource Label}" />
                        </DockPanel>
                        <local:NumberSlider x:Name="KeySoftnessPercentSlider" Text="{Binding KeySoftnessPercent}" Minimum="0" Maximum="100" TickFrequency="1" Margin="0,-4,0,10" />

                        <!-- 마스크 -->
                        <Border Style="{StaticResource Divider}" />
                        <TextBlock Text="마스크" Style="{StaticResource Title}" />
                        <DockPanel>
                            <ComboBox x:Name="MaskShapeBox" DockPanel.Dock="Right" Width="110" ItemsSource="{x:Static local:MainViewModel.MaskShapeNames}"
                                      SelectedIndex="{Binding MaskShapeIndex}" Focusable="False" />
                            <TextBlock Text="도형" Style="{StaticResource Label}" ToolTip="도형 안쪽만 보이게 합니다" />
                        </DockPanel>
                        <StackPanel x:Name="MaskSettings" Visibility="{Binding HasMask, Converter={StaticResource Visible}}">
                            <DockPanel>
                                <Button x:Name="MaskKeyButton" DockPanel.Dock="Right" Content="{Binding MaskKey}" Command="{Binding ToggleKeyframeCommand}" CommandParameter="Mask"
                                        Style="{StaticResource Key}" ToolTip="재생 위치에 마스크 위치·크기의 키프레임 찍기·지우기" />
                                <TextBox x:Name="MaskYBox" DockPanel.Dock="Right" Width="48" Margin="6,0,0,0" Text="{Binding MaskYPercent, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" ToolTip="위에서부터 (%)" />
                                <TextBox x:Name="MaskXBox" DockPanel.Dock="Right" Width="48" Text="{Binding MaskXPercent, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" ToolTip="왼쪽에서부터 (%)" />
                                <TextBlock Text="가운데 (%)" Style="{StaticResource Label}" ToolTip="클립 그림 안에서의 위치. 50, 50이 한가운데" />
                            </DockPanel>
                            <UniformGrid Columns="2" Margin="0,-4,0,10">
                                <local:NumberSlider x:Name="MaskXPercentSlider" Text="{Binding MaskXPercent}" Minimum="0" Maximum="100" TickFrequency="1" Margin="0,0,6,0" />
                                <local:NumberSlider x:Name="MaskYPercentSlider" Text="{Binding MaskYPercent}" Minimum="0" Maximum="100" TickFrequency="1" Margin="6,0,0,0" />
                            </UniformGrid>
                            <DockPanel>
                                <TextBox x:Name="MaskHeightBox" DockPanel.Dock="Right" Width="48" Margin="6,0,0,0" Text="{Binding MaskHeightPercent, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" ToolTip="높이 (%)" />
                                <TextBox x:Name="MaskWidthBox" DockPanel.Dock="Right" Width="48" Text="{Binding MaskWidthPercent, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" ToolTip="너비 (%)" />
                                <TextBlock Text="크기 (%)" Style="{StaticResource Label}" ToolTip="사각형·원의 너비와 높이. 자유 도형에는 쓰이지 않습니다." />
                            </DockPanel>
                            <UniformGrid Columns="2" Margin="0,-4,0,10">
                                <local:NumberSlider x:Name="MaskWidthPercentSlider" Text="{Binding MaskWidthPercent}" Minimum="1" Maximum="200" TickFrequency="1" Margin="0,0,6,0" />
                                <local:NumberSlider x:Name="MaskHeightPercentSlider" Text="{Binding MaskHeightPercent}" Minimum="1" Maximum="200" TickFrequency="1" Margin="6,0,0,0" />
                            </UniformGrid>
                            <DockPanel>
                                <TextBox x:Name="MaskFeatherBox" DockPanel.Dock="Right" Text="{Binding MaskFeather, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                                <TextBlock Text="가장자리 흐림" Style="{StaticResource Label}" />
                            </DockPanel>
                            <local:NumberSlider x:Name="MaskFeatherSlider" Text="{Binding MaskFeather}" Minimum="0" Maximum="100" TickFrequency="1" Margin="0,-4,0,10" />
                            <CheckBox x:Name="MaskInvertedBox" Content="반전 (도형 안쪽을 가림)" IsChecked="{Binding MaskInverted}" Focusable="False" Margin="0,0,0,8" />
                            <CheckBox x:Name="MaskEditingBox" Content="미리보기에서 마스크 편집" IsChecked="{Binding MaskEditing}" Focusable="False" Margin="0,0,0,8"
                                      ToolTip="켜면 미리보기에서 끌어서 마스크를 옮기고 휠로 크기를 바꿉니다. 자유 도형은 누른 곳에 점이 찍힙니다." />
                            <DockPanel Visibility="{Binding IsPolygonMask, Converter={StaticResource Visible}}">
                                <Button x:Name="ClearMaskPointsButton" DockPanel.Dock="Right" Content="점 모두 지우기" Command="{Binding ClearMaskPointsCommand}" Margin="0" Padding="8,4" />
                                <TextBlock x:Name="MaskPointLabel" Text="{Binding MaskPointText}" Style="{StaticResource Label}" ToolTip="점이 세 개 이상이면 마스크가 적용됩니다" />
                            </DockPanel>
                        </StackPanel>
                        <Border Style="{StaticResource Divider}" Margin="-16,4,-16,12" />
                    </StackPanel>

                    <!-- 텍스트 -->
                    <StackPanel x:Name="TextInspector" Visibility="{Binding HasTextSelection, Converter={StaticResource Visible}}">
                        <TextBlock x:Name="TextTitle" Text="{Binding TextTitle}" Style="{StaticResource Title}" />
                        <TextBox x:Name="TextContentBox" FontFamily="{StaticResource Ui}" FontSize="13" Text="{Binding TextContent, UpdateSourceTrigger=PropertyChanged}" AcceptsReturn="True" TextWrapping="Wrap"
                                 GotKeyboardFocus="OnTextContentFocus" LostKeyboardFocus="OnTextContentBlur"
                                 Width="Auto" HorizontalAlignment="Stretch" MinHeight="54" Margin="0,0,0,8" ToolTip="문구. Enter로 줄을 바꿉니다." />
                        <DockPanel>
                            <ComboBox x:Name="FontBox" DockPanel.Dock="Right" Width="150" ItemsSource="{x:Static local:MainViewModel.FontNames}"
                                      SelectedItem="{Binding FontName}" Focusable="False" />
                            <TextBlock Text="글꼴" Style="{StaticResource Label}" />
                        </DockPanel>
                        <DockPanel>
                            <CheckBox x:Name="BoldBox" DockPanel.Dock="Right" Content="굵게" IsChecked="{Binding TextBold}" Focusable="False" Margin="8,0,0,0" VerticalAlignment="Center" />
                            <TextBox x:Name="TextSizeBox" DockPanel.Dock="Right" Text="{Binding TextSize, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="크기" Style="{StaticResource Label}" />
                        </DockPanel>
                        <local:NumberSlider x:Name="TextSizeSlider" Text="{Binding TextSize}" Minimum="8" Maximum="300" TickFrequency="1" Margin="0,-4,0,10" />
                        <DockPanel>
                            <TextBox x:Name="TextColorBox" DockPanel.Dock="Right" Width="90" Text="{Binding TextColor, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="글자 색" Style="{StaticResource Label}" ToolTip="#RRGGBB. 앞에 두 자리를 더 쓰면 투명도(#AARRGGBB)." />
                        </DockPanel>
                        <DockPanel>
                            <TextBox x:Name="OutlineWidthBox" DockPanel.Dock="Right" Width="44" Margin="6,0,0,0" Text="{Binding OutlineWidth, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" ToolTip="두께 (0이면 없음)" />
                            <TextBox x:Name="OutlineColorBox" DockPanel.Dock="Right" Width="90" Text="{Binding OutlineColor, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="외곽선" Style="{StaticResource Label}" />
                        </DockPanel>
                        <local:NumberSlider x:Name="OutlineWidthSlider" Text="{Binding OutlineWidth}" Minimum="0" Maximum="40" TickFrequency="1" Margin="0,-4,0,10" />
                        <DockPanel>
                            <TextBox x:Name="ShadowOffsetBox" DockPanel.Dock="Right" Width="44" Margin="6,0,0,0" Text="{Binding ShadowOffset, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" ToolTip="거리 (0이면 없음)" />
                            <TextBox x:Name="ShadowColorBox" DockPanel.Dock="Right" Width="90" Text="{Binding ShadowColor, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="그림자" Style="{StaticResource Label}" />
                        </DockPanel>
                        <local:NumberSlider x:Name="ShadowOffsetSlider" Text="{Binding ShadowOffset}" Minimum="0" Maximum="40" TickFrequency="1" Margin="0,-4,0,10" />
                        <DockPanel>
                            <TextBox x:Name="BoxColorBox" DockPanel.Dock="Right" Width="90" Text="{Binding BoxColor, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="배경 박스" Style="{StaticResource Label}" ToolTip="색을 적으면 글자 뒤에 박스를 깝니다. 비우면 없음. 예: #CC000000" />
                        </DockPanel>
                        <DockPanel>
                            <TextBox x:Name="HighlightColorBox" DockPanel.Dock="Right" Width="90" Text="{Binding HighlightColor, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="단어 강조" Style="{StaticResource Label}" ToolTip="색을 적으면 말하는 단어를 그 색으로 강조합니다. 비우면 없음. 예: #FFE14D" />
                        </DockPanel>
                        <DockPanel>
                            <Button x:Name="TextPositionKeyButton" DockPanel.Dock="Right" Content="{Binding PositionKey}" Command="{Binding ToggleKeyframeCommand}" CommandParameter="Position"
                                    Style="{StaticResource Key}" ToolTip="재생 위치에 키프레임 찍기·지우기" />
                            <TextBox x:Name="TextYBox" DockPanel.Dock="Right" Width="56" Margin="6,0,0,0" Text="{Binding TextY, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" ToolTip="아래로 (픽셀)" />
                            <TextBox x:Name="TextXBox" DockPanel.Dock="Right" Width="56" Text="{Binding TextX, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" ToolTip="오른쪽으로 (픽셀)" />
                            <TextBlock Text="위치 X · Y" Style="{StaticResource Label}" />
                        </DockPanel>
                        <UniformGrid Columns="2" Margin="0,-4,0,10">
                            <local:NumberSlider x:Name="TextXSlider" Text="{Binding TextX}" Minimum="-2000" Maximum="2000" TickFrequency="1" Margin="0,0,6,0" />
                            <local:NumberSlider x:Name="TextYSlider" Text="{Binding TextY}" Minimum="-2000" Maximum="2000" TickFrequency="1" Margin="6,0,0,0" />
                        </UniformGrid>
                        <DockPanel>
                            <Button x:Name="ApplyStylePresetButton" DockPanel.Dock="Right" Content="적용" Command="{Binding ApplyStylePresetCommand}" Margin="4,0,0,0" Padding="8,4" />
                            <ComboBox x:Name="StylePresetBox" ItemsSource="{Binding StylePresetNames}" SelectedIndex="{Binding StylePresetIndex}" Focusable="False" />
                        </DockPanel>
                        <Button x:Name="SaveStylePresetButton" Content="이 스타일을 프리셋으로 저장" Click="OnSaveStylePresetClick" Margin="0,0,0,6" />
                        <Button x:Name="DeleteStylePresetButton" Content="고른 프리셋 삭제" Command="{Binding DeleteStylePresetCommand}" Margin="0,0,0,6" />
                        <Button x:Name="ApplyStyleToTrackButton" Content="이 트랙의 모든 텍스트에 적용" Command="{Binding ApplyStyleToTrackCommand}" Margin="0"
                                ToolTip="문구와 시간은 그대로 두고 스타일만 복사합니다" />
                        <Border Style="{StaticResource Divider}" Margin="-16,4,-16,12" />
                    </StackPanel>

                    <!-- 속도 -->
                    <StackPanel x:Name="SpeedInspector" Visibility="{Binding HasSpeedSelection, Converter={StaticResource Visible}}">
                        <TextBlock Text="속도" Style="{StaticResource Title}" />
                        <DockPanel>
                            <Button x:Name="SpeedKeyButton" DockPanel.Dock="Right" Content="{Binding SpeedKey}" Command="{Binding ToggleKeyframeCommand}" CommandParameter="Speed"
                                    Style="{StaticResource Key}" ToolTip="재생 위치에 속도 키프레임 찍기·지우기. 키프레임 사이에서 속도가 서서히 변합니다(속도 램프)." />
                            <TextBox x:Name="SpeedBox" DockPanel.Dock="Right" Text="{Binding SpeedPercent, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="속도 (%)" Style="{StaticResource Label}"
                                       ToolTip="25~400. 클립의 길이가 속도에 맞게 바뀝니다(뒤 클립이 있으면 그 앞까지만). 소리의 음높이는 유지됩니다." />
                        </DockPanel>
                        <local:NumberSlider x:Name="SpeedPercentSlider" Text="{Binding SpeedPercent}" Minimum="25" Maximum="400" TickFrequency="5" Margin="0,-4,0,10" />
                        <Button x:Name="FreezeFrameButton" Content="정지 프레임 만들기" Command="{Binding FreezeFrameCommand}" Margin="0"
                                ToolTip="재생 위치의 화면을 이미지로 저장하고 그 자리에 2초짜리 정지 화면을 끼워 넣습니다" />
                        <Border Style="{StaticResource Divider}" Margin="-16,4,-16,12" />
                    </StackPanel>

                    <!-- 오디오 클립과 그 트랙 -->
                    <StackPanel x:Name="Inspector" Visibility="{Binding HasAudioSelection, Converter={StaticResource Visible}}">
                        <TextBlock x:Name="InspectorTitle" Text="{Binding InspectorTitle}" Style="{StaticResource Title}" />

                        <DockPanel>
                            <Button x:Name="VolumeKeyButton" DockPanel.Dock="Right" Content="{Binding VolumeKey}" Command="{Binding ToggleKeyframeCommand}" CommandParameter="Volume"
                                    Style="{StaticResource Key}" ToolTip="재생 위치에 키프레임 찍기·지우기 (◆ 여기 있음, ◈ 다른 곳에 있음, ◇ 없음)" />
                            <TextBox x:Name="ClipVolumeBox" DockPanel.Dock="Right" Text="{Binding ClipVolume, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="볼륨 (%)" Style="{StaticResource Label}" ToolTip="0~200. 선택한 오디오 클립 모두에 적용됩니다." />
                        </DockPanel>
                        <local:NumberSlider x:Name="ClipVolumeSlider" Text="{Binding ClipVolume}" Minimum="0" Maximum="200" TickFrequency="1" Margin="0,-4,0,10" />
                        <DockPanel>
                            <TextBox x:Name="FadeInBox" DockPanel.Dock="Right" Text="{Binding FadeIn, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="페이드 인 (초)" Style="{StaticResource Label}" />
                        </DockPanel>
                        <local:NumberSlider x:Name="FadeInSlider" Text="{Binding FadeIn}" Minimum="0" Maximum="10" TickFrequency="0.1" Margin="0,-4,0,10" />
                        <DockPanel>
                            <TextBox x:Name="FadeOutBox" DockPanel.Dock="Right" Text="{Binding FadeOut, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="페이드 아웃 (초)" Style="{StaticResource Label}" />
                        </DockPanel>
                        <local:NumberSlider x:Name="FadeOutSlider" Text="{Binding FadeOut}" Minimum="0" Maximum="10" TickFrequency="0.1" Margin="0,-4,0,10" />
                        <Button x:Name="ApplyToTrackButton" Content="이 트랙의 모든 클립에 적용" Command="{Binding ApplyToTrackCommand}" Margin="0,0,0,16"
                                ToolTip="이 클립의 볼륨과 페이드를 같은 트랙의 모든 클립에 복사합니다" />

                        <Border Style="{StaticResource Divider}" />
                        <TextBlock Text="트랙" Style="{StaticResource Title}" />
                        <DockPanel>
                            <TextBox x:Name="TrackVolumeBox" DockPanel.Dock="Right" Text="{Binding TrackVolume, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="트랙 볼륨 (%)" Style="{StaticResource Label}" />
                        </DockPanel>
                        <local:NumberSlider x:Name="TrackVolumeSlider" Text="{Binding TrackVolume}" Minimum="0" Maximum="200" TickFrequency="1" Margin="0,-4,0,10" />
                        <DockPanel>
                            <ComboBox x:Name="DuckBox" DockPanel.Dock="Right" Width="110" ItemsSource="{Binding DuckOptions}"
                                      SelectedIndex="{Binding DuckIndex}" Focusable="False" />
                            <TextBlock Text="자동 감쇠 기준" Style="{StaticResource Label}"
                                       ToolTip="고른 트랙(예: 내레이션)에 클립이 있는 동안 이 트랙(예: BGM)의 소리를 줄입니다" />
                        </DockPanel>
                        <DockPanel>
                            <TextBox x:Name="DuckLevelBox" DockPanel.Dock="Right" Text="{Binding DuckLevel, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown" />
                            <TextBlock Text="감쇠 중 볼륨 (%)" Style="{StaticResource Label}" />
                        </DockPanel>
                        <local:NumberSlider x:Name="DuckLevelSlider" Text="{Binding DuckLevel}" Minimum="0" Maximum="100" TickFrequency="1" Margin="0,-4,0,10" />
                        <Border Style="{StaticResource Divider}" Margin="-16,4,-16,12" />
                    </StackPanel>

                    <!-- 키프레임과 애니메이션 프리셋 -->
                    <StackPanel x:Name="AnimationInspector">
                        <StackPanel.Style>
                            <Style TargetType="StackPanel">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding HasNoSelection}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed" />
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </StackPanel.Style>
                        <TextBlock Text="애니메이션" Style="{StaticResource Title}" />
                        <DockPanel>
                            <Button x:Name="NextKeyButton" DockPanel.Dock="Right" Content="다음 ◆" Command="{Binding JumpKeyframeCommand}" CommandParameter="1" Margin="4,0,0,0" Padding="8,4" />
                            <Button x:Name="PreviousKeyButton" DockPanel.Dock="Right" Content="◆ 이전" Command="{Binding JumpKeyframeCommand}" CommandParameter="-1" Margin="0" Padding="8,4" />
                            <TextBlock Text="키프레임 이동" Style="{StaticResource Label}" />
                        </DockPanel>
                        <DockPanel>
                            <ComboBox x:Name="EasingBox" DockPanel.Dock="Right" Width="130" ItemsSource="{x:Static local:MainViewModel.EasingNames}"
                                      SelectedIndex="{Binding EasingIndex}" Focusable="False" />
                            <TextBlock Text="이징" Style="{StaticResource Label}"
                                       ToolTip="재생 위치의 키프레임에서 다음 키프레임까지 값이 변하는 속도. 새로 찍는 키프레임에도 적용됩니다." />
                        </DockPanel>
                        <DockPanel>
                            <Button x:Name="ApplyPresetButton" DockPanel.Dock="Right" Content="적용" Command="{Binding ApplyPresetCommand}" Margin="4,0,0,0" Padding="8,4" />
                            <ComboBox x:Name="PresetBox" ItemsSource="{Binding PresetNames}" SelectedIndex="{Binding PresetIndex}" Focusable="False" />
                        </DockPanel>
                        <Button x:Name="SavePresetButton" Content="이 움직임을 프리셋으로 저장" Click="OnSavePresetClick" Margin="0,0,0,6"
                                IsEnabled="{Binding HasAnimation}" />
                        <Button x:Name="DeletePresetButton" Content="고른 프리셋 삭제" Command="{Binding DeletePresetCommand}" Margin="0,0,0,6" />
                        <Button x:Name="ClearKeyframesButton" Content="키프레임 모두 지우기" Command="{Binding ClearKeyframesCommand}" Margin="0"
                                IsEnabled="{Binding HasAnimation}" />
                    </StackPanel>
                </StackPanel>
                </ScrollViewer>
            </Border>
            <!-- 패널 사이의 경계를 끌어 너비를 바꾼다. -->
            <GridSplitter Grid.Column="0" Width="5" HorizontalAlignment="Right" VerticalAlignment="Stretch" Background="Transparent" Focusable="False" />
            <GridSplitter Grid.Column="2" Width="5" HorizontalAlignment="Left" VerticalAlignment="Stretch" Background="Transparent" Focusable="False" />
        </Grid>

        <!-- 프로젝트가 없을 때 -->
        <StackPanel Grid.Row="1" Grid.RowSpan="2" HorizontalAlignment="Center" VerticalAlignment="Center" Width="260">
            <StackPanel.Style>
                <Style TargetType="StackPanel">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding HasProject}" Value="True">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </StackPanel.Style>
            <Border Width="48" Height="48" CornerRadius="12" Background="{StaticResource Accent}" HorizontalAlignment="Center">
                <Path Data="M6 4 L20 12 L6 20 Z" Fill="#101114" Width="24" Height="24" />
            </Border>
            <TextBlock Text="NGvid" FontSize="24" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,12,0,0" />
            <TextBlock Text="영상 편집기" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,4,0,24" />
            <Button x:Name="StartNewButton" Content="새 프로젝트" Click="OnNewClick" Style="{StaticResource MainPrimary}" Height="44" Margin="0,0,0,8" />
            <Button x:Name="StartOpenButton" Content="프로젝트 열기" Click="OnOpenClick" Height="44" Margin="0,0,0,8" />
            <Button x:Name="StartLinkButton" Content="링크로 프로젝트 시작" Click="OnNewFromLinkClick" Height="44" Margin="0" />
        </StackPanel>

        <!-- 타임라인 -->
        <Border Grid.Row="2" Background="{StaticResource Panel}" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0"
                Visibility="{Binding HasProject, Converter={StaticResource Visible}}">
            <DockPanel>
                <Border DockPanel.Dock="Top" BorderBrush="{StaticResource Line}" BorderThickness="0,0,0,1" Padding="12,8">
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal">
                            <TextBlock Text="확대" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Margin="0,0,8,0" />
                            <Slider x:Name="ZoomSlider" Minimum="0" Maximum="1" Value="{Binding TimelineZoom}" Width="140"
                                    Focusable="False" VerticalAlignment="Center" ToolTip="Ctrl + 마우스 휠" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="SplitButton" Style="{StaticResource MainGhost}" Command="{Binding SplitCommand}" Margin="0,0,4,0"
                                    AutomationProperties.Name="분할" ToolTip="선택한 클립을 재생 위치에서 분할 (Ctrl+K)">
                                <Path Style="{StaticResource Icon}" StrokeThickness="1.5" Width="14" Height="14"
                                      Data="M2 11 A2 2 0 1 0 6 11 A2 2 0 1 0 2 11 M8 11 A2 2 0 1 0 12 11 A2 2 0 1 0 8 11 M5 9 L10 2 M9 9 L4 2" />
                            </Button>
                            <ToggleButton x:Name="SnapButton" IsChecked="{Binding SnapEnabled}" Style="{StaticResource Toggle}" Width="32" Height="32" Margin="0,0,4,0"
                                          AutomationProperties.Name="스냅" ToolTip="스냅: 재생 위치선과 클립이 클립 경계·마커에 달라붙습니다">
                                <Path Style="{StaticResource Icon}" StrokeThickness="1.5" Width="14" Height="14" Data="M3 2 V7 A4 4 0 0 0 11 7 V2 M3 4 H5 M9 4 H11" />
                            </ToggleButton>
                            <Button x:Name="AddMarkerButton" Style="{StaticResource MainGhost}" Command="{Binding AddMarkerCommand}" Margin="0"
                                    AutomationProperties.Name="마커 추가" ToolTip="재생 위치에 마커 추가 (M)">
                                <Path Style="{StaticResource Icon}" StrokeThickness="1.5" Width="14" Height="14" Data="M3 2 H11 V9 L7 12 L3 9 Z" />
                            </Button>
                            <Border Width="1" Height="20" Background="{StaticResource Line}" Margin="10,0" />
                            <Button x:Name="AddTrackButton" Content="＋ 트랙" Click="OnAddTrackClick" Style="{StaticResource MainOutline}" Height="32" Padding="10,0">
                                <Button.ContextMenu>
                                    <ContextMenu>
                                        <MenuItem Header="영상 트랙" Command="{Binding AddTrackCommand}" CommandParameter="video" />
                                        <MenuItem Header="오디오 트랙" Command="{Binding AddTrackCommand}" CommandParameter="audio" />
                                    </ContextMenu>
                                </Button.ContextMenu>
                            </Button>
                        </StackPanel>
                    </DockPanel>
                </Border>

                <!-- 오디오 미터 -->
                <Border DockPanel.Dock="Right" Width="56" BorderBrush="{StaticResource Line}" BorderThickness="1,0,0,0" Padding="0,10"
                        ToolTip="재생 중인 소리의 좌·우 크기. 빨간색이면 소리가 찢어집니다.">
                    <DockPanel>
                        <TextBlock DockPanel.Dock="Top" Text="dB" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,6" />
                        <TextBlock DockPanel.Dock="Bottom" Text="L  R" FontSize="10" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0" />
                        <local:AudioMeterView x:Name="Meter" HorizontalAlignment="Center" />
                    </DockPanel>
                </Border>

                <ScrollBar x:Name="TimelineScroll" DockPanel.Dock="Bottom" Orientation="Horizontal" Margin="180,0,0,0"
                           ValueChanged="OnTimelineScroll" Focusable="False" />

                <!-- 처음 높이는 눈금 + 트랙 4개다(TimelineRow). 트랙이 더 많으면 세로로 스크롤한다. -->
                <!-- shortcut: 세로로 스크롤하면 시간 눈금도 함께 올라간다. 불편하면 눈금을 따로 고정한다. -->
                <ScrollViewer VerticalScrollBarVisibility="Auto" Focusable="False">
                    <Grid MinHeight="{Binding ViewportHeight, RelativeSource={RelativeSource AncestorType=ScrollViewer}}">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="180" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>

                        <StackPanel Grid.Column="0">
                            <Border Height="28" BorderBrush="{StaticResource Line}" BorderThickness="0,0,1,1" />
                            <ItemsControl x:Name="TrackHeaders" ItemsSource="{Binding Tracks}" Focusable="False">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Height="48" Background="#191B1F" BorderBrush="#23262C" BorderThickness="0,0,1,1" Padding="10,0,6,0">
                                            <Border.ContextMenu>
                                                <ContextMenu>
                                                    <MenuItem Header="위로" Click="OnTrackUpClick" />
                                                    <MenuItem Header="아래로" Click="OnTrackDownClick" />
                                                    <MenuItem Header="색상" ItemsSource="{x:Static local:TrackItem.Palette}" Click="OnTrackColorClick">
                                                        <MenuItem.ItemTemplate>
                                                            <DataTemplate>
                                                                <Border Width="60" Height="14" CornerRadius="3" Background="{Binding}" />
                                                            </DataTemplate>
                                                        </MenuItem.ItemTemplate>
                                                    </MenuItem>
                                                    <Separator />
                                                    <MenuItem Header="트랙 삭제" Click="OnTrackDeleteClick" />
                                                </ContextMenu>
                                            </Border.ContextMenu>
                                            <DockPanel>
                                                <Border DockPanel.Dock="Left" Width="4" Height="24" CornerRadius="2" Background="{Binding Color}" Margin="0,0,6,0" />
                                                <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                    <ToggleButton IsChecked="{Binding Locked}" Style="{StaticResource Toggle}"
                                                                  AutomationProperties.Name="잠금" ToolTip="잠금: 이 트랙의 클립을 편집할 수 없게 합니다">
                                                        <Path Style="{StaticResource Icon}" StrokeThickness="1.3" Width="12" Height="12"
                                                              Data="M2 5 H10 V11 H2 Z M4 5 V3.5 A2 2 0 0 1 8 3.5 V5" />
                                                    </ToggleButton>
                                                    <ToggleButton IsChecked="{Binding Hidden}" Style="{StaticResource Toggle}"
                                                                  Visibility="{Binding IsVisual, Converter={StaticResource Visible}}"
                                                                  AutomationProperties.Name="숨김" ToolTip="숨김: 화면에 그리지 않습니다">
                                                        <Path Style="{StaticResource Icon}" StrokeThickness="1.3" Width="12" Height="12"
                                                              Data="M1 6 C3 2.5 9 2.5 11 6 C9 9.5 3 9.5 1 6 Z M4.5 6 A1.5 1.5 0 1 0 7.5 6 A1.5 1.5 0 1 0 4.5 6" />
                                                    </ToggleButton>
                                                    <ToggleButton Content="M" IsChecked="{Binding Muted}" Style="{StaticResource Toggle}" FontSize="11" FontWeight="Bold"
                                                                  Visibility="{Binding IsAudio, Converter={StaticResource Visible}}" ToolTip="음소거" />
                                                    <ToggleButton Content="S" IsChecked="{Binding Solo}" Style="{StaticResource Toggle}" FontSize="11" FontWeight="Bold"
                                                                  Visibility="{Binding IsAudio, Converter={StaticResource Visible}}" ToolTip="솔로: 이 트랙만 듣기" />
                                                </StackPanel>
                                                <TextBox Text="{Binding Name, UpdateSourceTrigger=LostFocus}" KeyDown="OnNameKeyDown"
                                                         Background="Transparent" BorderThickness="0" Padding="0"
                                                         FontSize="12" VerticalAlignment="Center" />
                                            </DockPanel>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>

                        <local:TimelineView Grid.Column="1" x:Name="Timeline" />
                    </Grid>
                </ScrollViewer>
            </DockPanel>
        </Border>

        <!-- 타임라인의 위쪽 경계를 끌어 높이를 바꾼다. -->
        <GridSplitter Grid.Row="2" Height="5" VerticalAlignment="Top" HorizontalAlignment="Stretch" Background="Transparent" Focusable="False"
                      Visibility="{Binding HasProject, Converter={StaticResource Visible}}" />

        <!-- 알림 -->
        <TextBlock Grid.Row="3" x:Name="StatusLabel" Text="{Binding StatusText}" Foreground="#FFB454" Margin="16,6" TextWrapping="Wrap">
            <TextBlock.Style>
                <Style TargetType="TextBlock">
                    <Style.Triggers>
                        <DataTrigger Binding="{Binding StatusText}" Value="">
                            <Setter Property="Visibility" Value="Collapsed" />
                        </DataTrigger>
                    </Style.Triggers>
                </Style>
            </TextBlock.Style>
        </TextBlock>
    </Grid>
</Window>
