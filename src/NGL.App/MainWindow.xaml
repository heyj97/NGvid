<Window x:Class="NGL.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:skia="clr-namespace:SkiaSharp.Views.WPF;assembly=SkiaSharp.Views.WPF"
        Title="NGvid" Width="1280" Height="800" MinWidth="640" MinHeight="400"
        Background="#101114" Foreground="#E6E7EA" FontSize="14"
        AllowDrop="True" Drop="OnDrop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="#17181C" BorderBrush="#2A2D33" BorderThickness="0,0,0,1" Padding="12,8">
            <DockPanel>
                <Button DockPanel.Dock="Left" Content="영상 열기" Click="OnOpenClick"
                        Padding="16,6" Background="#4C8DFF" Foreground="#0B0C0E" BorderThickness="0" FontWeight="Bold" />
                <TextBlock Text="{Binding InfoText}" Margin="16,0,0,0" VerticalAlignment="Center"
                           Foreground="#A7ACB4" TextTrimming="CharacterEllipsis" />
            </DockPanel>
        </Border>

        <skia:SKGLElement Grid.Row="1" x:Name="Preview" PaintSurface="OnPaintSurface" />

        <Border Grid.Row="2" Background="#17181C" BorderBrush="#2A2D33" BorderThickness="0,1,0,0" Padding="16,12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" Margin="16,0,0,0"
                           VerticalAlignment="Center" FontFamily="Consolas" />
                <Slider x:Name="PositionSlider" Minimum="0" Maximum="{Binding LastFrameSeconds}"
                        Value="{Binding PositionSeconds}" SmallChange="{Binding FrameStepSeconds}" LargeChange="1"
                        IsMoveToPointEnabled="True" VerticalAlignment="Center" />
            </DockPanel>
        </Border>
    </Grid>
</Window>
