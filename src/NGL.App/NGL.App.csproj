<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\NGL.Core\NGL.Core.csproj" />
    <ProjectReference Include="..\NGL.Commands\NGL.Commands.csproj" />
    <ProjectReference Include="..\NGL.IO\NGL.IO.csproj" />
    <ProjectReference Include="..\NGL.Playback\NGL.Playback.csproj" />
    <ProjectReference Include="..\NGL.Export\NGL.Export.csproj" />
  </ItemGroup>

  <!-- scripts/install-ffmpeg.ps1로 배치한 FFmpeg DLL을 출력 폴더의 ffmpeg/로 복사한다. -->
  <ItemGroup>
    <None Include="..\..\ffmpeg\*.dll" Link="ffmpeg\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" Visible="false" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="SkiaSharp.Views.WPF" Version="4.156.0" />
  </ItemGroup>

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UseWPF>true</UseWPF>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

</Project>
