<Window x:Class="NGL.App.NewProjectWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="새 프로젝트" Width="640" SizeToContent="Height" ResizeMode="NoResize"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Background="{StaticResource Panel}" Foreground="{StaticResource Text}" FontSize="14">
    <Window.Resources>
        <Style x:Key="Label" TargetType="TextBlock">
            <Setter Property="Foreground" Value="{StaticResource Muted}" />
            <Setter Property="FontSize" Value="13" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
    </Window.Resources>
    <DockPanel>
        <Border DockPanel.Dock="Bottom" BorderBrush="{StaticResource Line}" BorderThickness="0,1,0,0" Padding="20,16">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="취소" IsCancel="True" Style="{StaticResource Dialog}" />
                <Button x:Name="CreateButton" Content="만들기" IsDefault="True" Click="OnCreateClick" Style="{StaticResource DialogPrimary}" Margin="8,0,0,0" />
            </StackPanel>
        </Border>

        <StackPanel Margin="20">
            <StackPanel x:Name="LinkPanel" Visibility="Collapsed" Margin="0,0,0,20">
                <TextBlock Text="영상 링크" Style="{StaticResource Label}" />
                <TextBox x:Name="LinkBox" Height="40" Padding="12,0" />
            </StackPanel>

            <TextBlock Text="프로젝트 이름" Style="{StaticResource Label}" />
            <TextBox x:Name="NameBox" Height="40" Padding="12,0" />

            <TextBlock Text="저장 위치" Style="{StaticResource Label}" Margin="0,20,0,8" />
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="찾아보기" Click="OnBrowseClick" Style="{StaticResource Dialog}" Padding="14,0" Margin="8,0,0,0" />
                <TextBox x:Name="LocationBox" Height="40" Padding="12,0" FontFamily="{StaticResource Mono}" FontSize="13" />
            </DockPanel>

            <TextBlock Text="비율" Style="{StaticResource Label}" Margin="0,20,0,8" />
            <ListBox x:Name="PresetBox" Background="Transparent" BorderThickness="0" Padding="0" Margin="-6,0"
                     ItemContainerStyle="{StaticResource CardItem}" ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                <ListBox.ItemsPanel>
                    <ItemsPanelTemplate>
                        <UniformGrid Rows="1" />
                    </ItemsPanelTemplate>
                </ListBox.ItemsPanel>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <StackPanel>
                            <!-- 화면 비율을 보여주는 작은 사각형 -->
                            <Viewbox Width="64" Height="42">
                                <Border Width="{Binding Width}" Height="{Binding Height}" BorderBrush="{StaticResource Text2}" BorderThickness="60" CornerRadius="90" />
                            </Viewbox>
                            <TextBlock Text="{Binding Name}" FontWeight="Bold" HorizontalAlignment="Center" Margin="0,10,0,0" />
                            <TextBlock FontSize="12" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,6,0,0">
                                <Run Text="{Binding Width, Mode=OneWay}" /><Run Text="×" /><Run Text="{Binding Height, Mode=OneWay}" />
                            </TextBlock>
                        </StackPanel>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>

            <TextBlock Text="프레임레이트" Style="{StaticResource Label}" Margin="0,20,0,8" />
            <Border Width="240" HorizontalAlignment="Left" Background="{StaticResource Input}" BorderBrush="{StaticResource InputLine}"
                    BorderThickness="1" CornerRadius="8" Padding="3">
                <ListBox x:Name="FrameRateBox" Background="Transparent" BorderThickness="0" Padding="0"
                         ItemContainerStyle="{StaticResource SegmentItem}">
                    <ListBox.ItemsPanel>
                        <ItemsPanelTemplate>
                            <UniformGrid Rows="1" />
                        </ItemsPanelTemplate>
                    </ListBox.ItemsPanel>
                </ListBox>
            </Border>

            <ProgressBar x:Name="DownloadProgress" Visibility="Collapsed" Maximum="100" Margin="0,20,0,0" />
            <TextBlock x:Name="ErrorText" Margin="0,16,0,0" Foreground="#FF7A7A" TextWrapping="Wrap" />
        </StackPanel>
    </DockPanel>
</Window>
